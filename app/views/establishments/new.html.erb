<% content_for :title, "Novo cadastro" %>
<% content_for :container_width, "max-w-5xl" %>

<section class="card bg-base-100 shadow-sm">
  <div class="card-body gap-8">
    <div>
      <p class="eyebrow">Cadastro manual</p>
      <h1 class="page-title">Cadastrar estabelecimento</h1>
      <p class="page-description">
        Mesmas regras do import: EC de 8 dígitos, CNPJ de 14, EC preso ao CNPJ e ao canal.
        Faturamento é opcional; se informado, a soma dos dias precisa bater com o total.
      </p>
    </div>

    <%= form_with url: establishments_path, method: :post, class: "grid gap-8" do %>
      <fieldset class="w-full min-w-0">
        <legend class="mb-4 text-sm font-semibold tracking-wide uppercase opacity-60">Identidade</legend>
        <div class="grid gap-4 sm:grid-cols-2">
          <%= render "form_field", name: :report_id, label: "Report ID", required: true,
            hint: "Identificador externo do canal", list: "report_id_options",
            placeholder: "1478" %>
          <%= render "form_field", name: :channel_name, label: "Canal", required: true,
            list: "canal_options", placeholder: "MASTER FRANQUEADO RAMOS E SILVA" %>
          <%= render "form_field", name: :sub_channel_name, label: "Sub-canal", required: true,
            list: "sub_canal_options", placeholder: "MIC GOIANIA 4" %>
          <%= render "form_field", name: :contract_status, label: "Status do contrato", required: true,
            as: :select, options: EstablishmentsHelper::CONTRACT_STATUSES %>
          <%= render "form_field", name: :ec, label: "EC", required: true,
            hint: "8 dígitos", placeholder: "32546997" %>
          <%= render "form_field", name: :cnpj, label: "CNPJ", required: true,
            hint: "14 dígitos", placeholder: "55092685000135" %>
        </div>
      </fieldset>

      <fieldset class="w-full min-w-0">
        <legend class="mb-4 text-sm font-semibold tracking-wide uppercase opacity-60">Nome e atividade</legend>
        <div class="grid gap-4 sm:grid-cols-2">
          <%= render "form_field", name: :legal_name, label: "Razão social" %>
          <%= render "form_field", name: :trade_name, label: "Nome fantasia" %>
          <%= render "form_field", name: :entity_type, label: "Tipo de pessoa", placeholder: "PJ" %>
          <%= render "form_field", name: :business_line, label: "Ramo de atividade" %>
          <%= render "form_field", name: :cnae_code, label: "CNAE", placeholder: "5611201" %>
          <%= render "form_field", name: :cnae_description, label: "Descrição do CNAE" %>
        </div>
      </fieldset>

      <fieldset class="w-full min-w-0">
        <legend class="mb-4 text-sm font-semibold tracking-wide uppercase opacity-60">Endereço e contato</legend>
        <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          <div class="sm:col-span-2 lg:col-span-3">
            <%= render "form_field", name: :street_address, label: "Endereço" %>
          </div>
          <%= render "form_field", name: :cep, label: "CEP" %>
          <%= render "form_field", name: :city, label: "Cidade" %>
          <%= render "form_field", name: :state, label: "UF", as: :select,
            options: EstablishmentsHelper::BRAZILIAN_STATES %>
          <%= render "form_field", name: :work_phone, label: "Telefone" %>
          <%= render "form_field", name: :contact_name_1, label: "Contato 1" %>
          <%= render "form_field", name: :contact_name_2, label: "Contato 2" %>
        </div>
      </fieldset>

      <fieldset class="w-full min-w-0">
        <legend class="mb-4 text-sm font-semibold tracking-wide uppercase opacity-60">Classificação</legend>
        <div class="grid gap-4 sm:grid-cols-2">
          <%= render "form_field", name: :presumed_segment, label: "Segmento presumido",
            placeholder: "PJ1" %>
          <%= render "form_field", name: :performed_segment, label: "Segmento performado",
            placeholder: "PJ3" %>
        </div>
      </fieldset>

      <fieldset class="w-full min-w-0">
        <legend class="mb-4 text-sm font-semibold tracking-wide uppercase opacity-60">Faturamento (opcional)</legend>
        <div class="grid gap-4 sm:grid-cols-2">
          <%= render "form_field", name: :previous_period, label: "Competência M-1", as: :date %>
          <%= render "form_field", name: :current_period, label: "Competência atual", as: :date %>
          <%= render "form_field", name: :previous_month_total, label: "Faturamento M-1" %>
          <%= render "form_field", name: :current_month_total, label: "Faturamento mês atual" %>
        </div>
        <div class="mt-4 grid gap-4 lg:grid-cols-2">
          <% [ [ "Mês anterior", "m1" ], [ "Mês atual", nil ] ].each do |label, suffix| %>
            <details class="collapse collapse-arrow border border-base-300 bg-base-100">
              <summary class="collapse-title font-medium"><%= label %> por dia</summary>
              <div class="collapse-content grid grid-cols-2 gap-3 sm:grid-cols-4">
                <% (1..31).each do |day| %>
                  <% name = suffix ? format("day_%02d_%s", day, suffix) : format("day_%02d", day) %>
                  <%= render "form_field", name:, label: format("Dia %02d", day),
                    type: "number", step: "0.01" %>
                <% end %>
              </div>
            </details>
          <% end %>
        </div>
      </fieldset>

      <datalist id="report_id_options">
        <% @channels.each do |channel| %>
          <option value="<%= channel.external_id %>"><%= channel.name %></option>
        <% end %>
      </datalist>
      <datalist id="canal_options">
        <% @channels.each do |channel| %>
          <option value="<%= channel.name %>"></option>
        <% end %>
      </datalist>
      <datalist id="sub_canal_options">
        <% @sub_channel_names.each do |sub_channel_name| %>
          <option value="<%= sub_channel_name %>"></option>
        <% end %>
      </datalist>

      <div class="flex flex-wrap gap-3">
        <%= submit_tag "Cadastrar", class: "btn btn-primary" %>
        <%= link_to "Cancelar", establishments_path, class: "btn btn-ghost" %>
      </div>
    <% end %>
  </div>
</section>
