<% content_for :title, "EC #{@establishment.ec}" %>

<div class="grid gap-5">
  <section class="page-hero">
    <div class="relative z-10 flex flex-wrap items-start justify-between gap-6">
      <div>
        <p class="eyebrow">EC <%= @establishment.ec %></p>
        <h1 class="page-title">
          <%= present_or_dash(@snapshot&.trade_name.presence || @snapshot&.legal_name) %>
        </h1>
        <p class="page-description">
          <%= formatted_cnpj(@establishment.company.cnpj) %>
          · <%= present_or_dash(@snapshot&.sub_channel&.name) %>
        </p>
      </div>
      <div class="relative z-10 flex flex-wrap items-center gap-2">
        <%= contract_status_badge(@snapshot&.contract_status) %>
        <%= link_to icon_label("arrow-left", "Voltar à lista"), establishments_path, class: "btn btn-outline btn-sm" %>
      </div>
    </div>

  </section>

  <%# Todos os ECs do CNPJ, porque o cliente é a empresa e o EC é o grão técnico: quem chega
      pela listagem cai num deles e precisa ver que existem outros.
      Não há selo de duplicata: `primary_establishment_id` está vazio nos 564 ECs da carteira,
      e nenhum caminho do import o preenche — a duplicata é registrada como anomalia em
      `data_anomalies`, sem ligar um EC ao outro. O alerta "Principal: ..." que vivia no topo
      desta tela nunca teve o que mostrar, pelo mesmo motivo. %>
  <section class="table-frame">
    <div class="table-toolbar">
      <div>
        <p class="section-label">Mesmo CNPJ</p>
        <h2 class="table-title">
          <%= pluralize(@company_establishments.size, "EC deste cliente", "ECs deste cliente") %>
        </h2>
      </div>
    </div>
    <div class="table-scroll" role="region" tabindex="0"
      aria-label="Estabelecimentos do CNPJ <%= formatted_cnpj(@establishment.company.cnpj) %>">
      <table class="table">
        <caption class="sr-only">
          ECs do CNPJ <%= formatted_cnpj(@establishment.company.cnpj) %>, com MIC e situação
        </caption>
        <thead>
          <tr>
            <th scope="col">EC</th>
            <th scope="col">MIC</th>
            <th scope="col">Estabelecimento</th>
            <th scope="col">Status</th>
          </tr>
        </thead>
        <tbody>
          <% @company_establishments.each do |sibling| %>
            <% sibling_snapshot = sibling.current_map_snapshot %>
            <tr>
              <th scope="row" class="font-mono font-normal">
                <% if sibling == @establishment %>
                  <%= sibling.ec %>
                  <span class="badge badge-ghost">nesta tela</span>
                <% else %>
                  <%= link_to sibling.ec, sibling, class: "establishment-link" %>
                <% end %>
              </th>
              <td><%= present_or_dash(sibling_snapshot&.sub_channel&.name) %></td>
              <td><%= present_or_dash(sibling_snapshot&.trade_name.presence || sibling_snapshot&.legal_name) %></td>
              <td><%= contract_status_badge(sibling_snapshot&.contract_status) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </section>

  <section class="table-frame">
    <div class="table-toolbar">
      <div>
        <p class="section-label">Cadastro</p>
        <h2 class="table-title">Ficha do estabelecimento</h2>
      </div>
    </div>
    <div class="grid gap-5 p-5 lg:grid-cols-2">
  <%= render "detail_group", title: "Identidade", rows: [
    [ "EC", @establishment.ec ],
    [ "CNPJ", formatted_cnpj(@establishment.company.cnpj) ],
    [ "Master", channel_name(@establishment.channel) ],
    [ "MIC", @snapshot&.sub_channel&.name ],
    [ "Status do contrato", @snapshot&.contract_status ],
    [ "Tipo de pessoa", @snapshot&.entity_type ]
  ] %>

  <%= render "detail_group", title: "Nome e atividade", rows: [
    [ "Nome fantasia", @snapshot&.trade_name ],
    [ "Razão social", @snapshot&.legal_name ],
    [ "Ramo de atividade", @snapshot&.business_line ],
    [ "CNAE", @snapshot&.cnae_code ],
    [ "Descrição do CNAE", @snapshot&.cnae_description ],
    [ "Segmento presumido", @snapshot&.presumed_segment ],
    [ "Segmento performado", @snapshot&.performed_segment ],
    [ "Status de reciprocidade", @snapshot&.reciprocity_status ]
  ] %>

  <%= render "detail_group", title: "Endereço e contato", rows: [
    [ "Endereço", @snapshot&.street_address ],
    [ "CEP", formatted_cep(@snapshot&.cep) ],
    [ "Cidade", @snapshot&.city ],
    [ "UF", @snapshot&.state ],
    [ "Telefone", @snapshot&.work_phone ],
    [ "Contato 1", @snapshot&.contact_name_1 ],
    [ "Contato 2", @snapshot&.contact_name_2 ]
  ] %>

  <%= render "detail_group", title: "Atividade", rows: [
    [ "Ativo no mês atual", boolean_label(@snapshot&.active_current_month) ],
    [ "Ativo no último mês", boolean_label(@snapshot&.active_previous_month) ],
    [ "Ativo nos últimos 30 dias", boolean_label(@snapshot&.active_last_30_days) ],
    [ "Última transação", format_date(@snapshot&.last_transaction_on) ],
    [ "Credenciamento", format_date(@snapshot&.accredited_on) ],
    [ "Instalação", format_date(@snapshot&.installed_on) ],
    [ "Ativação", format_date(@snapshot&.activated_on) ],
    [ "Suspensão", format_date(@snapshot&.suspended_on) ]
  ] %>

  <%# O resumo e o NET MDR são os mesmos da linha da listagem por subcanal: a página do EC
      não pode mostrar menos do que a linha de onde se veio. Abaixo dele, o grão do Mapa —
      Smart POS e Demais POS aparecem somados como POS só no resumo. %>
  <%= render "detail_group", title: "Produtos e terminais", rows: [
    [ "NET MDR", net_mdr_label(@snapshot&.net_mdr, @snapshot&.net_mdr_status) ],
    [ "Resumo", @snapshot && equipment_summary(@snapshot) ],
    [ "Soluções financeiras", @snapshot&.financial_solutions ],
    [ "Link de pagamento", boolean_label(@snapshot&.has_payment_link) ],
    [ "Total de terminais", @snapshot&.total_terminals_count ],
    [ "Smart POS", @snapshot&.smart_pos_count ],
    [ "Demais POS", @snapshot&.other_pos_count ],
    [ "TEF", @snapshot&.tef_count ],
    [ "TAP on phone", @snapshot&.tap_on_phone_count ],
    [ "MPS", @snapshot&.mps_count ],
    [ "PIN", @snapshot&.pin_count ],
    [ "Outros terminais", @snapshot&.other_terminals_count ],
    [ "Agenda semanal", @snapshot&.weekly_schedule ],
    [ "Melhor conversa", @snapshot&.best_conversation_raw ]
  ] %>
    </div>
  </section>
</div>
