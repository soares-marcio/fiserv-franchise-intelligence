<% content_for :title, client_crumb_label %>

<div class="grid grid-cols-1 gap-5">
  <section class="page-hero">
    <div class="relative z-10 flex flex-wrap items-start justify-between gap-6">
      <div>
        <p class="eyebrow">Estabelecimento</p>
        <h1 class="page-title">
          <%= present_or_dash(@snapshot&.trade_name.presence || @snapshot&.legal_name) %>
        </h1>
        <p class="page-description">
          <%= formatted_cnpj(@company.cnpj) %>
          · <%= @establishments.filter_map { |e| e.current_map_snapshot&.sub_channel&.name }.uniq.join(" · ").presence || "—" %>
        </p>
      </div>
      <div class="relative z-10 flex flex-wrap items-center gap-2">
        <%# Status do cliente pela regra da casa: ativo com ao menos um EC ativo, suspenso só
            quando todos estão suspensos. É a mesma regra das abas da tela de MIC. %>
        <%= contract_status_badge(client_contract_status(@establishments)) %>
        <span class="badge badge-ghost">
          <%= pluralize(@establishments.size, "EC contratado", "ECs contratados") %>
        </span>
        <%= link_to icon_label("arrow-left", "Voltar à lista"), establishments_path, class: "btn btn-sm" %>
      </div>
    </div>
  </section>

  <%# Cadastro do estabelecimento: o que é do CNPJ, não do produto. Endereço, CNAE e segmento
      presumido vêm do EC de menor número — a mesma regra efetiva da listagem, para as duas
      telas mostrarem o mesmo cliente. Quando algum desses campos difere entre os ECs, a tela
      avisa em vez de escolher em silêncio. %>
  <section class="table-frame">
    <div class="table-toolbar">
      <div>
        <p class="section-label">Cadastro</p>
        <h2 class="table-title">Ficha do estabelecimento</h2>
      </div>
      <% if @diverging.any? %>
        <span class="badge badge-ghost tooltip tooltip-left" tabindex="0"
          data-tip="Os ECs deste CNPJ trazem valores diferentes no Mapa; a ficha mostra os do EC de menor número">
          <%= "difere entre ECs: #{@diverging.map { |field| client_field_label(field) }.to_sentence}" %>
        </span>
      <% end %>
    </div>
    <div class="grid gap-5 p-5 lg:grid-cols-2">
      <%= render "detail_group", title: "Identidade", rows: [
        [ "CNPJ", formatted_cnpj(@company.cnpj) ],
        [ "Razão social", @snapshot&.legal_name ],
        [ "Nome fantasia", @snapshot&.trade_name ],
        [ "Master", channel_name(@establishments.first&.channel) ],
        [ "Tipo de pessoa", @snapshot&.entity_type ]
      ] %>

      <%= render "detail_group", title: "Atividade econômica", rows: [
        [ "Ramo de atividade", @snapshot&.business_line ],
        [ "CNAE", @snapshot&.cnae_code ],
        [ "Descrição do CNAE", @snapshot&.cnae_description ],
        [ "Segmento presumido", @snapshot&.presumed_segment ]
      ] %>

      <%= render "detail_group", title: "Endereço e contato", rows: [
        [ "Endereço", @snapshot&.street_address ],
        [ "CEP", formatted_cep(@snapshot&.cep) ],
        [ "Cidade", @snapshot&.city ],
        [ "UF", @snapshot&.state ],
        [ "Telefone", @snapshot&.work_phone ],
        [ "Contato 1", @snapshot&.contact_name_1 ],
        [ "Contato 2", @snapshot&.contact_name_2 ]
      ] %>
    </div>
  </section>

  <%# Um card por EC: o EC é o produto contratado — POS, Smart POS, link de pagamento —, e é
      aqui que moram as particularidades dele. Medido na carteira: 173 dos 187 CNPJs com mais
      de um EC têm equipamento diferente entre eles. O segmento performado também é do EC:
      vale "Inativo" quando aquele EC não performou, e diverge em 172 dos 187. %>
  <section class="grid gap-4">
    <div class="table-toolbar table-toolbar--bare">
      <div>
        <p class="section-label">Produtos contratados</p>
        <h2 class="table-title">
          <%= pluralize(@establishments.size, "EC neste estabelecimento", "ECs neste estabelecimento") %>
        </h2>
      </div>
    </div>
    <div class="ec-card-grid">
      <% @establishments.each do |establishment| %>
        <%= render "ec_card", establishment:, snapshot: establishment.current_map_snapshot %>
      <% end %>
    </div>
  </section>
</div>
