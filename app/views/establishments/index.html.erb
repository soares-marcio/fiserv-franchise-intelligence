<% content_for :title, "Estabelecimentos" %>

<div class="grid grid-cols-1 gap-5">
  <section class="page-hero">
    <p class="eyebrow">Carteira ativa</p>
    <h1 class="page-title">Estabelecimentos</h1>
    <p class="page-description">
      Cadastro corrente do mapa: nome, CNAE, endereço e MIC do último lote
      validado. O EC continua sendo o grão técnico; o cliente é o CNPJ.
    </p>
  </section>

  <section class="filter-panel">
    <%# A lista responde enquanto se digita: o formulário mira o frame da listagem e o
        Turbo troca só ele, mantendo a URL com ?q= para compartilhar o filtro. %>
    <%= form_with url: establishments_path, method: :get, class: "flex flex-wrap items-end gap-3",
      data: { turbo_frame: "establishments", turbo_action: "advance", controller: "live-form" } do %>
      <label class="grid w-full max-w-xl min-w-0 gap-1.5">
        <span class="section-label">Buscar</span>
        <%= search_field_tag :q, @query, class: "input input-bordered w-full",
          placeholder: "EC, CNPJ, nome, cidade, CNAE ou MIC", autocomplete: "off",
          data: { action: "input->live-form#submit" } %>
      </label>
      <%# Digitar reinicia a página, mas mantém o tamanho escolhido. %>
      <%= hidden_field_tag :per_page, @per_page %>
      <%= button_tag icon_label("magnifying-glass", "Buscar"), type: "submit", class: "btn btn-outline btn--field" %>
      <% if @query.present? %>
        <%= link_to icon_label("eraser", "Limpar"), establishments_path, class: "btn btn-ghost btn--field" %>
      <% end %>
    <% end %>
  </section>

  <%# Links de página e de tamanho ficam dentro do frame: o Turbo troca só a listagem e
      "advance" mantém a URL em dia para compartilhar. %>
  <%# O diálogo da anotação fica fora do turbo_frame: dentro dele, o Turbo procuraria o frame
      na resposta do redirect e engoliria o flash. O controller do Stimulus envolve os dois,
      para o botão de dentro do frame alcançar o diálogo de fora. %>
  <div data-controller="note-modal">
  <%= turbo_frame_tag "establishments", data: { turbo_action: "advance" } do %>
  <section class="table-frame" data-controller="sticky-table">
    <div class="table-toolbar">
      <div>
        <p class="section-label">Cadastro corrente</p>
        <h2 class="table-title">Um cliente por linha, com seus ECs</h2>
      </div>
      <% if @total_count.positive? %>
        <div class="table-toolbar__meta">
          <span class="badge badge-ghost">
            <%= pluralize(@total_count, "cliente", "clientes") %>
            · <%= pluralize(@total_establishments, "EC", "ECs") %>
          </span>
          <div class="per-page">
            <span class="section-label">Por página</span>
            <div class="join">
              <% EstablishmentsController::PER_PAGE_OPTIONS.each do |size| %>
                <%= link_to size, establishments_path(listing_params(per_page: size, page: 1)),
                  class: "join-item btn btn-sm #{size == @per_page ? "btn-primary" : "btn-outline"}" %>
              <% end %>
            </div>
          </div>
        </div>
      <% end %>
    </div>
    <div class="table-scroll" role="region" tabindex="0"
      aria-label="Clientes e estabelecimentos, rolável na horizontal">
  <table class="table">
    <thead>
      <tr>
        <th scope="col">Cliente</th>
        <th scope="col">CNPJ</th>
        <th scope="col">MIC</th>
        <th scope="col">Endereço</th>
        <th scope="col">CNAE</th>
        <th scope="col">Status</th>
        <th scope="col">Segmento</th>
        <th scope="col" class="note-col">Anotação</th>
      </tr>
    </thead>
    <tbody>
      <% @companies.each do |company| %>
        <% establishments = @establishments_by_company.fetch(company) %>
        <%# O EC de referência é o que não é duplicata de outro; entre vários, o menor. %>
        <% lead = establishments.find { |e| e.primary_establishment.nil? } || establishments.first %>
        <% snapshot = lead.current_map_snapshot %>
        <tr class="align-top">
          <td>
            <%# O nome do cliente é o link da linha, e leva ao mesmo lugar que a busca global:
                o cadastro do EC de referência. Os ECs abaixo continuam levando cada um ao seu. %>
            <%# turbo_frame: "_top" porque a listagem vive dentro do frame "establishments",
                e o cadastro não tem esse frame: sem isso o Turbo responde "Content missing"
                e a tela fica vazia. É o mesmo motivo do target="_top" da busca global. %>
            <p class="font-medium">
              <%= link_to present_or_dash(snapshot&.trade_name.presence || snapshot&.legal_name),
                establishment_path(company), class: "establishment-link",
                data: { turbo_frame: "_top" } %>
            </p>
            <% if snapshot&.legal_name.present? && snapshot.legal_name != snapshot.trade_name %>
              <p class="max-w-xs text-xs opacity-60"><%= snapshot.legal_name %></p>
            <% end %>
            <p class="mt-1 text-xs">
              <% establishments.each_with_index do |establishment, index| %>
                <%= " · " if index.positive? %><%# A ficha é do cliente: o chip do EC leva ao bloco daquele EC dentro dela. %>
                <%= link_to "EC #{establishment.ec}",
                  establishment_path(company, anchor: "ec-#{establishment.ec}"),
                  class: "link link-hover font-mono", data: { turbo_frame: "_top" } %>
              <% end %>
            </p>
          </td>
          <td class="font-mono text-xs whitespace-nowrap"><%= formatted_cnpj(company.cnpj) %></td>
          <td>
            <p><%= establishments.filter_map { |e| e.current_map_snapshot&.sub_channel&.name }.uniq.join(" · ").presence || "—" %></p>
            <p class="text-xs opacity-60"><%= channel_name(lead.channel) %></p>
          </td>
          <td>
            <p class="max-w-xs"><%= present_or_dash(snapshot&.street_address) %></p>
            <p class="text-xs opacity-70">
              <%= [ snapshot&.city, snapshot&.state ].compact_blank.join(" · ").presence || "—" %>
              <% if snapshot&.cep.present? %>
                · <%= formatted_cep(snapshot.cep) %>
              <% end %>
            </p>
          </td>
          <td>
            <p class="font-mono text-xs"><%= present_or_dash(snapshot&.cnae_code) %></p>
            <p class="max-w-xs text-xs opacity-70"><%= present_or_dash(snapshot&.cnae_description) %></p>
          </td>
          <td>
            <%= contract_status_badge(snapshot&.contract_status) %>
            <% if establishments.size > 1 %>
              <p class="mt-1 text-xs opacity-60"><%= establishments.size %> ECs</p>
            <% end %>
          </td>
          <td>
            <p><%= present_or_dash(snapshot&.performed_segment) %></p>
            <% if snapshot&.business_line.present? %>
              <p class="max-w-[10rem] text-xs opacity-60"><%= snapshot.business_line %></p>
            <% end %>
          </td>
          <%# A anotação é do CNPJ, e aqui a linha já é o cliente: a mesma célula das outras
              telas, com o botão e o ponto de "já tem". O texto fica no modal e na ficha. %>
          <td class="note-col">
            <% nota = @notes_by_cnpj[company.cnpj] %>
            <%= render "shared/company_note_cell", company_uuid: company.uuid,
              name: present_or_dash(snapshot&.trade_name.presence || snapshot&.legal_name),
              note_id: nota&.id, note_updated_at: nota&.updated_at,
              note_params: listing_params(origin: "establishments") %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
    </div>
    <% if @companies.empty? %>
      <div class="empty-state">
        <p>
        <% if @query.present? %>
          Nenhum cliente encontrado para “<%= @query %>”.
        <% else %>
          Nenhum cliente cadastrado ainda.
        <% end %>
        </p>
      </div>
    <% elsif @total_pages > 1 %>
      <nav class="pagination-bar" aria-label="Paginação">
        <%= link_to icon_label("caret-left", "Anterior"), establishments_path(listing_params(page: [ @page - 1, 1 ].max)),
          class: "btn btn-sm btn-outline #{'pointer-events-none opacity-40' if @page <= 1}",
          aria: { disabled: @page <= 1 } %>
        <span class="pagination-bar__status">Página <%= @page %> de <%= @total_pages %></span>
        <%= link_to safe_join([ "Próxima", icon("caret-right", css: "btn-icon") ]), establishments_path(listing_params(page: [ @page + 1, @total_pages ].min)),
          class: "btn btn-sm btn-outline #{'pointer-events-none opacity-40' if @page >= @total_pages}",
          aria: { disabled: @page >= @total_pages } %>
      </nav>
    <% end %>
  </section>
  <% end %>
  <%= render "shared/company_note_modal" %>
  </div>
</div>
