<%# locals: title:, rows: %>
<section class="rounded-xl border border-base-300 bg-base-200/40 p-5">
  <h2 class="section-label mb-4"><%= title %></h2>
  <dl class="grid gap-x-8 gap-y-4 sm:grid-cols-2">
    <% rows.each do |label, value| %>
      <div>
        <dt class="text-xs font-semibold opacity-55"><%= label %></dt>
        <dd class="mt-1 break-words font-medium"><%= value.nil? || value == "" ? "—" : value %></dd>
      </div>
    <% end %>
  </dl>
</section>
