<% field_id = "manual_entry_#{name}" %>
<% value = manual_entry_value(name) %>
<% field_as = local_assigns.fetch(:as, :text) %>
<% required = local_assigns.fetch(:required, false) %>
<div class="grid min-w-0 gap-1.5">
  <label for="<%= field_id %>" class="text-sm font-semibold">
    <%= label %>
    <% if required %>
      <span class="text-error">*</span>
    <% end %>
  </label>
  <% case field_as %>
  <% when :select %>
    <%= select_tag "manual_entry[#{name}]",
      options_for_select(options, value),
      include_blank: "Selecione", id: field_id, class: "select select-bordered w-full", required: required %>
  <% when :date %>
    <%= date_field_tag "manual_entry[#{name}]", value, id: field_id, class: "input input-bordered w-full" %>
  <% else %>
    <%= text_field_tag "manual_entry[#{name}]", value,
      id: field_id, class: "input input-bordered w-full", required: required,
      list: local_assigns[:list], autocomplete: local_assigns[:autocomplete],
      placeholder: local_assigns[:placeholder], type: local_assigns[:type],
      step: local_assigns[:step] %>
  <% end %>
  <% if local_assigns[:hint].present? %>
    <p class="text-xs opacity-60"><%= hint %></p>
  <% end %>
</div>
