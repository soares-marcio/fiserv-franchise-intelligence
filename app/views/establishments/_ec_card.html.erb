<%# Card de um EC — o produto contratado no estabelecimento. Compacto de propósito: com quatro
    ECs, dois blocos de treze linhas cada viravam uma página de rolagem em que tudo se parecia.
    O que distingue um EC do outro é o equipamento, então ele é o título; e campo vazio ou
    zerado não entra, porque "Demais POS 0 · TAP 0 · MPS 0 · PIN 0" ocupava metade do card
    para dizer que não existe. %>
<article class="ec-card" id="ec-<%= establishment.ec %>">
  <header class="ec-card__head">
    <div>
      <p class="section-label">EC <%= establishment.ec %></p>
      <h3 class="ec-card__equipment">
        <%= snapshot ? equipment_summary(snapshot).presence || "Sem equipamento no Mapa" : "Sem cadastro no Mapa" %>
      </h3>
      <p class="ec-card__mic"><%= present_or_dash(snapshot&.sub_channel&.name) %></p>
    </div>
    <%= contract_status_badge(snapshot&.contract_status) %>
  </header>

  <% if snapshot %>
    <%# Os contadores por tipo ficam na dica: quem precisa do grão vê, quem não precisa lê o
        resumo do título. %>
    <% grao = [ [ "Smart POS", snapshot.smart_pos_count ], [ "Demais POS", snapshot.other_pos_count ],
                [ "TEF", snapshot.tef_count ], [ "TAP on phone", snapshot.tap_on_phone_count ],
                [ "MPS", snapshot.mps_count ], [ "PIN", snapshot.pin_count ],
                [ "Outros", snapshot.other_terminals_count ] ]
              .select { |_, count| count.to_i.positive? } %>
    <% if grao.any? %>
      <p class="ec-card__terminals tooltip tooltip-bottom" tabindex="0"
        data-tip="<%= grao.map { |nome, count| "#{count} #{nome}" }.join(" · ") %>">
        <%= pluralize(snapshot.total_terminals_count.to_i, "terminal", "terminais") %>
      </p>
    <% end %>

    <dl class="ec-card__facts">
      <% fatos = [
        [ "NET MDR", net_mdr_label(snapshot.net_mdr, snapshot.net_mdr_status) ],
        [ "Soluções financeiras", snapshot.financial_solutions ],
        [ "Link de pagamento", ("Sim" if snapshot.has_payment_link) ],
        [ "Segmento performado", snapshot.performed_segment ],
        [ "Reciprocidade", snapshot.reciprocity_status ],
        [ "Credenciamento", format_date(snapshot.accredited_on) ],
        [ "Instalação", format_date(snapshot.installed_on) ],
        [ "Ativação", format_date(snapshot.activated_on) ],
        [ "Suspensão", format_date(snapshot.suspended_on) ],
        [ "Última transação", format_date(snapshot.last_transaction_on) ],
        [ "Agenda semanal", snapshot.weekly_schedule ]
      ].reject { |_, valor| valor.blank? || valor == "—" } %>
      <% fatos.each do |rotulo, valor| %>
        <div>
          <dt><%= rotulo %></dt>
          <dd><%= valor %></dd>
        </div>
      <% end %>
    </dl>

    <%# Atividade só aparece quando é verdade: três "Não" seguidos não dizem mais que a
        ausência das marcas. %>
    <% atividade = { "mês atual" => snapshot.active_current_month,
                     "mês anterior" => snapshot.active_previous_month,
                     "últimos 30 dias" => snapshot.active_last_30_days }.select { |_, v| v } %>
    <% if atividade.any? %>
      <p class="ec-card__activity">
        Com movimento no <%= atividade.keys.to_sentence %>
      </p>
    <% end %>

    <% if snapshot.best_conversation_raw.present? %>
      <p class="ec-card__talk">
        <span class="section-label">Melhor conversa</span>
        <%= snapshot.best_conversation_raw %>
      </p>
    <% end %>
  <% end %>
</article>
