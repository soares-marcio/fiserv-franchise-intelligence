<% content_for :title, "Metabase" %>

<div class="grid gap-5 lg:grid-cols-[1fr_1.4fr]">
  <section class="page-hero">
    <p class="eyebrow">Exploração segura</p>
    <h1 class="page-title">Metabase</h1>
    <p class="page-description">
      Análise ad-hoc na role somente leitura. A interface sobe em
      <%= link_to "localhost:3001", "http://localhost:3001", class: "link", target: "_blank", rel: "noreferrer" %>.
    </p>
    <%= link_to "Abrir Metabase", "http://localhost:3001", class: "btn btn-primary relative z-10 mt-6",
      target: "_blank", rel: "noreferrer" %>
  </section>
  <section class="surface-card p-6">
    <p class="section-label">Conexão</p>
    <h2 class="mt-1 text-xl font-bold tracking-tight">Acesso somente leitura</h2>
    <div class="mt-5 overflow-x-auto rounded-xl border border-base-300">
      <table class="table w-auto">
        <tbody>
          <tr><th>Host (Compose)</th><td class="font-mono"><%= @host %></td></tr>
          <tr><th>Host (máquina local)</th><td class="font-mono">127.0.0.1</td></tr>
          <tr><th>Porta</th><td class="font-mono"><%= @port %></td></tr>
          <tr><th>Database</th><td class="font-mono"><%= @database %></td></tr>
          <tr><th>User</th><td class="font-mono"><%= @username %></td></tr>
          <tr><th>Password</th><td>Definida por <span class="font-mono">METABASE_RO_PASSWORD</span></td></tr>
        </tbody>
      </table>
    </div>
    <h3 class="mt-6 font-semibold">Views liberadas</h3>
    <ul class="mt-3 grid gap-2 sm:grid-cols-2">
      <% @views.each do |view| %>
        <li class="rounded-lg bg-base-200 px-3 py-2 font-mono text-xs"><%= view %></li>
      <% end %>
    </ul>
    <p class="mt-4 text-sm opacity-70">Tabelas de escrita e <span class="font-mono">raw_import_rows</span> não têm SELECT.</p>
  </section>
</div>
