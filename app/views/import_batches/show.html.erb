<%= turbo_stream_from "import_batches" %>
<% content_for :title, @import_batch.source_filename %>

<section class="page-hero">
  <div class="card-body">
    <p class="eyebrow">Detalhes do lote</p>
    <h1 class="page-title break-words"><%= @import_batch.source_filename %></h1>
    <p class="page-description">
      <%= channel_name(@import_batch.channel) || "Master ainda não identificado" %> ·
      <%= import_status_badge(@import_batch) %>
      <% if @import_batch.current_month_cutoff_day %>
        · corte dia <%= @import_batch.current_month_cutoff_day %>
      <% end %>
    </p>

    <% if @import_batch.status == "failed" && @import_batch.validation_errors.any? %>
      <%= render "failure_report", batch: @import_batch %>
    <% end %>

    <% if @import_batch.validation_errors.any? && @import_batch.status == "validated" %>
      <div class="alert alert-error mt-4" role="alert">
        <div>
          <p class="font-semibold">Importado com ressalva</p>
          <ul class="mt-1 list-disc pl-5 text-sm">
            <% @import_batch.validation_errors.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      </div>
    <% end %>

    <% if @import_batch.running? %>
      <div class="alert alert-info mt-4" role="status" aria-live="polite">
        <span class="loading loading-spinner loading-sm" aria-hidden="true"></span>
        <span>Importando… esta tela avisa sozinha quando terminar.</span>
      </div>
    <% end %>

    <%= form_with url: update_cutoff_import_batch_path(@import_batch), method: :patch,
      class: "relative z-10 mt-6 flex flex-wrap items-end gap-3" do %>
      <label class="form-control">
        <span class="label-text">Ajustar dia de corte</span>
        <%= number_field_tag :max_known_day, @import_batch.current_month_cutoff_day, min: 1, max: 31, class: "input input-bordered w-24" %>
      </label>
      <%= submit_tag "Ajustar corte", class: "btn btn-outline btn--field" %>
    <% end %>

    <%= button_to icon_label("arrow-counter-clockwise", "Reprocessar lote"), reprocess_import_batch_path(@import_batch), method: :post,
      class: "btn btn-outline mt-4",
      data: { turbo_confirm: "Reprocessar consolidação e views deste lote?" } %>

    <% if @import_batch.discardable? %>
      <%= button_to icon_label("trash", "Descartar lote"), import_batch_path(@import_batch), method: :delete,
        class: "btn btn-danger mt-4",
        form: { data: { turbo_confirm: "Descartar o lote #{@import_batch.source_filename}?" } } %>
    <% end %>
  </div>
</section>

<% if policy(@import_batch).grant? %>
  <section class="surface-card mt-5 p-6">
    <p class="section-label">Quem vê este arquivo</p>
    <p class="metric-hint mt-1">
      A planilha é a carteira inteira do Master. Além de quem enviou, só a vê quem receber a
      liberação aqui — e só pode recebê-la quem tem esse Master inteiro.
    </p>

    <% if @grants.any? %>
      <ul class="mt-3 grid gap-2 text-sm">
        <% @grants.each do |grant| %>
          <li class="flex flex-wrap items-center justify-between gap-3">
            <span><%= grant.user.name %> <span class="opacity-70">· <%= grant.user.email_address %></span></span>
            <%= button_to "Revogar", import_batch_batch_grant_path(@import_batch, grant), method: :delete,
              class: "btn btn-danger btn-sm",
              form: { data: { turbo_confirm: "Revogar a liberação de #{grant.user.name}?" } } %>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="metric-hint mt-3">Ninguém além de quem enviou.</p>
    <% end %>

    <% if @eligible.any? %>
      <%= form_with url: import_batch_batch_grants_path(@import_batch),
        class: "mt-4 flex flex-wrap items-end gap-3" do |form| %>
        <label class="form-control">
          <span class="label-text">Liberar para</span>
          <%= form.select :user_id,
            @eligible.map { |person| [ "#{person.name} · #{person.email_address}", person.to_param ] },
            {}, class: "select select-bordered" %>
        </label>
        <%= form.submit "Liberar arquivo", class: "btn btn-outline btn--field" %>
      <% end %>
    <% else %>
      <p class="metric-hint mt-3">
        Ninguém mais elegível: as pessoas que você administra ou já têm o arquivo, ou não têm
        este Master inteiro.
      </p>
    <% end %>
  </section>
<% end %>
