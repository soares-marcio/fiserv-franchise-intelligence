<% content_for :title, "Importar arquivo BIN" %>

<section class="page-hero">
    <p class="eyebrow">Entrada de dados</p>
    <h1 class="page-title">Importar arquivo BIN</h1>
    <p class="page-description">
      Envie a planilha mensal da Fiserv. Cada arquivo importado vira um lote com data e
      hora; o mesmo arquivo não é importado duas vezes.
    </p>

    <%= form_with url: import_batches_path, method: :post, multipart: true,
      class: "relative z-10 mt-6 flex flex-wrap items-end gap-3" do %>
      <label class="grid w-full max-w-md gap-1.5">
        <span class="section-label">Arquivo XLSX</span>
        <%= file_field_tag :file, accept: ".xlsx,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet", class: "file-input file-input-bordered w-full", required: true %>
      </label>
      <%= button_tag icon_label("upload-simple", "Iniciar importação"), type: "submit", class: "btn btn-primary btn--field",
        data: { turbo_confirm: "Importar este arquivo agora?" } %>
      <p class="basis-full text-xs opacity-70">
        Precisa ter as abas <strong>Faturamento</strong>, <strong>Ativacao</strong> e
        <strong>Mapa de Clientes BIN</strong>; outras abas são ignoradas.
      </p>
    <% end %>
</section>

<%= turbo_stream_from "import_batches" %>

<div class="metric-grid metric-grid--3 mt-5">
  <article class="metric-card" data-tone="<%= ImportBatch.stale? ? "rose" : "green" %>">
    <p class="metric-label"><%= icon("calendar-check", css: "metric-icon") %>Último arquivo recebido</p>
    <p class="metric-value"><%= last_file_headline(@days_since_last_file) %></p>
    <p class="metric-hint"><%= last_file_hint(@days_since_last_file) %></p>
  </article>

  <% if @running_batch %>
    <article class="metric-card" data-tone="teal" role="status" aria-live="polite">
      <p class="metric-label"><%= icon("file-arrow-up", css: "metric-icon") %>Importação</p>
      <p class="metric-value">
        <span class="loading loading-spinner loading-sm" aria-hidden="true"></span> Importando
      </p>
      <p class="metric-hint">
        <strong><%= @running_batch.source_filename %></strong> — esta tela avisa sozinha quando terminar, não precisa recarregar.
      </p>
    </article>
  <% elsif @stuck_batches.any? %>
    <article class="metric-card" data-tone="gold" role="alert">
      <p class="metric-label"><%= icon("file-arrow-up", css: "metric-icon") %>Importação</p>
      <p class="metric-value">Pendente</p>
      <p class="metric-hint">
        <strong><%= @stuck_batches.first.source_filename %></strong> está pendente desde
        <%= @stuck_batches.first.created_at.strftime("%d/%m %H:%M") %>. Importação não costuma demorar tanto: verifique se o worker está no ar.
      </p>
    </article>
  <% elsif @last_batch&.status == "failed" %>
    <article class="metric-card" data-tone="rose" role="alert">
      <p class="metric-label"><%= icon("file-arrow-up", css: "metric-icon") %>Última importação</p>
      <p class="metric-value">Falhou</p>
      <p class="metric-hint">
        <%= link_to @last_batch.source_filename, @last_batch, class: "link" %> —
        <%= @last_batch.validation_errors.first %>
      </p>
    </article>
  <% elsif @last_batch %>
    <article class="metric-card" data-tone="green">
      <p class="metric-label"><%= icon("file-arrow-up", css: "metric-icon") %>Última importação</p>
      <p class="metric-value">Importado</p>
      <p class="metric-hint">
        <%= link_to @last_batch.source_filename, @last_batch, class: "link" %>
        em <%= @last_batch.created_at.strftime("%d/%m %H:%M") %>
        <% if @last_batch.current_month_cutoff_day %> · corte dia <%= @last_batch.current_month_cutoff_day %><% end %>
      </p>
    </article>
  <% else %>
    <article class="metric-card">
      <p class="metric-label"><%= icon("file-arrow-up", css: "metric-icon") %>Última importação</p>
      <p class="metric-value">Nenhuma</p>
      <p class="metric-hint">O primeiro lote aparece aqui assim que for enviado.</p>
    </article>
  <% end %>

  <article class="metric-card" data-tone="<%= @worker_alive ? "green" : "rose" %>">
    <p class="metric-label"><%= icon("cpu", css: "metric-icon") %>Worker de importação</p>
    <p class="metric-value"><%= @worker_alive ? "Ativo" : "Parado" %></p>
    <p class="metric-hint">
      <% if @worker_heartbeat_at %>
        Último sinal <%= heartbeat_label(@worker_heartbeat_at) %>.
        <% unless @worker_alive %>Os envios ficam aguardando até o serviço voltar; avise o suporte.<% end %>
      <% else %>
        Nenhum worker registrado: o serviço que processa os arquivos não está no ar. Os envios ficam aguardando; avise o suporte.
      <% end %>
    </p>
  </article>
</div>

<section class="table-frame mt-5" data-controller="sticky-table">
  <div class="table-toolbar">
    <div>
      <p class="section-label">Histórico</p>
      <h2 class="table-title">Lotes recentes</h2>
    </div>
  </div>
    <div class="table-scroll">
      <table class="table">
        <thead>
          <tr>
            <th>Arquivo</th>
            <th>Canal</th>
            <th>Corte</th>
            <th>Status</th>
            <th>Quando</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% @import_batches.each do |batch| %>
            <tr>
              <td><%= link_to batch.source_filename, batch, class: "link" %></td>
              <td><%= batch.channel&.name || "—" %></td>
              <td><%= batch.current_month_cutoff_day ? "dia #{batch.current_month_cutoff_day}" : "—" %></td>
              <td>
                <%= import_status_badge(batch) %>
                <% if batch.validation_errors.any? %>
                  <p class="mt-1 text-xs opacity-70"><%= batch.validation_errors.first %></p>
                <% end %>
              </td>
              <td><%= batch.created_at.strftime("%d/%m/%Y %H:%M") %></td>
              <td class="text-right">
                <% if batch.discardable? %>
                  <%= button_to icon_label("trash", "Descartar"), import_batch_path(batch), method: :delete,
                    class: "btn btn-ghost btn-sm",
                    form: { data: { turbo_confirm: "Descartar o lote #{batch.source_filename}?" } } %>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
      <% if @import_batches.empty? %>
        <div class="empty-state">Nenhum lote importado.</div>
      <% end %>
    </div>
</section>
