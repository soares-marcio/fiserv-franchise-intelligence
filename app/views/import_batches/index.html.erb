<% content_for :title, "Importar arquivo BIN" %>

<section class="page-hero">
    <p class="eyebrow">Entrada de dados</p>
    <h1 class="page-title">Importar arquivo BIN</h1>
    <p class="page-description">
      Cada arquivo válido vira um snapshot imutável. Reenvio do mesmo arquivo
      (mesmo checksum) é rejeitado.
    </p>

    <%= form_with url: import_batches_path, method: :post, multipart: true,
      class: "relative z-10 mt-6 grid max-w-3xl gap-3 sm:grid-cols-[1fr_auto] sm:items-end" do %>
      <label class="grid gap-1.5">
        <span class="section-label">Arquivo XLSX</span>
        <%= file_field_tag :file, accept: ".xlsx,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet", class: "file-input file-input-bordered w-full max-w-md", required: true %>
      </label>
      <%= submit_tag "Iniciar importação", class: "btn btn-primary",
        data: { turbo_confirm: "Importar este arquivo agora?" } %>
    <% end %>
</section>

<%= turbo_stream_from "import_batches" %>

<div class="metric-grid mt-5">
  <article class="metric-card" data-tone="<%= ImportBatch.stale? ? "rose" : "green" %>">
    <p class="metric-label">Último arquivo recebido</p>
    <p class="metric-value"><%= last_file_headline(@days_since_last_file) %></p>
    <p class="metric-hint"><%= last_file_hint(@days_since_last_file) %></p>
  </article>
</div>

<% if @running_batch %>
  <div class="alert alert-info mt-5" role="status" aria-live="polite">
    <span class="loading loading-spinner loading-sm" aria-hidden="true"></span>
    <span>
      Importando <strong><%= @running_batch.source_filename %></strong>… esta tela avisa
      sozinha quando terminar, não precisa recarregar.
    </span>
  </div>
<% end %>

<% @stuck_batches.each do |batch| %>
  <div class="alert alert-warning mt-5" role="alert">
    <span>
      <strong><%= batch.source_filename %></strong> está pendente desde
      <%= batch.created_at.strftime("%d/%m/%Y %H:%M") %>. Importação não costuma demorar tanto:
      verifique se o worker está no ar.
    </span>
  </div>
<% end %>

<section class="table-frame mt-5">
  <div class="table-toolbar">
    <div>
      <p class="section-label">Histórico</p>
      <h2 class="table-title">Lotes recentes</h2>
    </div>
  </div>
    <div class="overflow-x-auto">
      <table class="table">
        <thead>
          <tr>
            <th>Arquivo</th>
            <th>Canal</th>
            <th>Corte</th>
            <th>Status</th>
            <th>Quando</th>
          </tr>
        </thead>
        <tbody>
          <% @import_batches.each do |batch| %>
            <tr>
              <td><%= link_to batch.source_filename, batch, class: "link" %></td>
              <td><%= batch.channel&.name || "—" %></td>
              <td><%= batch.current_month_cutoff_day ? "dia #{batch.current_month_cutoff_day}" : "—" %></td>
              <td>
                <%= import_status_badge(batch) %>
                <% if batch.validation_errors.any? %>
                  <p class="mt-1 text-xs opacity-70"><%= batch.validation_errors.first %></p>
                <% end %>
              </td>
              <td><%= batch.created_at.strftime("%d/%m/%Y %H:%M") %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
      <% if @import_batches.empty? %>
        <div class="empty-state">Nenhum lote importado.</div>
      <% end %>
    </div>
</section>
