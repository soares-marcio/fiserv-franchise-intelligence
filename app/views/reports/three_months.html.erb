<% content_for :title, "Ganhos 3M" %>

<div class="grid gap-5">
  <section class="page-hero">
    <p class="eyebrow">Modelo de remuneração</p>
    <h1 class="page-title">Ganhos 3M por subcanal</h1>
    <p class="page-description">
      O modelo dos primeiros 3 meses: escolha o mês de credenciamento (M0) e a apuração segue
      na janela M0, M1 e M2. A tabela mostra o faturamento da <strong>carteira inteira</strong>
      de cada subcanal nesses meses, quantos ECs foram <strong>credenciados no M0</strong> e o
      prêmio de entrada da safra. O repasse recorrente e o acelerador/redutor vivem na página
      <%= link_to "Recorrente", recurring_reports_path, class: "link" %>.
    </p>
  </section>

  <section class="filter-panel">
    <%= form_with url: three_months_reports_path, method: :get,
      class: "flex flex-wrap items-end gap-3" do %>
      <label class="grid gap-1.5">
        <span class="section-label">Canal da carteira</span>
        <%= select_tag :channel_id,
          options_for_select([["Todos os canais", ""]] + @channels.map { |channel| [channel.name, channel.uuid] },
            @selected_channel&.uuid),
          class: "select select-bordered w-auto min-w-52 max-w-full" %>
      </label>
      <label class="grid gap-1.5">
        <span class="section-label">Mês de credenciamento (M0)</span>
        <%# Só meses com volume mensal importado: a planilha limita a escolha, não o sistema. %>
        <%= select_tag :start_period,
          options_for_select(@available_periods.map { |period| [three_month_window_label(period), period.strftime("%Y-%m")] },
            @window&.first&.strftime("%Y-%m")),
          class: "select select-bordered w-auto min-w-64 max-w-full" %>
      </label>
      <%= button_tag icon_label("funnel", "Aplicar"), type: "submit", class: "btn btn-primary btn--field" %>
      <%# A escolha aplicada fica escrita ao lado do botão: o select sozinho não deixava
          claro o que estava valendo depois do Aplicar. %>
      <% if @window %>
        <p class="metric-hint self-center">
          Exibindo <strong><%= three_month_window_label(@window.first) %></strong>
          <%= "· #{@selected_channel.name}" if @selected_channel %>
        </p>
      <% end %>
    <% end %>
  </section>

  <% if @window %>
    <%# Os quatro cards são a SOMA dos subcanais listados abaixo, no recorte aplicado —
        a dúvida "é de qual subcanal?" já apareceu em uso real, daí o rótulo explícito. %>
    <p class="section-label">
      Totais do recorte — soma dos <%= @reports.size %> subcanais listados
    </p>
    <% digitalization = @reports.sum { |r| r[:prize][:digitalization] } %>
    <% addon_without = @reports.sum { |r| r[:prize][:addon_without_auto] } %>
    <% addon_with = @reports.sum { |r| r[:prize][:addon_with_auto] } %>
    <section class="metric-grid">
      <article class="metric-card" data-tone="teal">
        <p class="metric-label">ECs credenciados no M0</p>
        <p class="metric-value"><%= @reports.sum { |r| r[:prize][:accredited] } %></p>
        <p class="metric-hint">Safra de <%= l(@window.first, format: "%B de %Y") %></p>
      </article>
      <article class="metric-card" data-tone="gold">
        <p class="metric-label">Digitalização (determinada)</p>
        <p class="metric-value"><%= brl(digitalization) %></p>
        <p class="metric-hint">R$ 30,00 por EC com app, uma vez em M0</p>
      </article>
      <article class="metric-card" data-tone="green">
        <p class="metric-label">Adicional por faturamento</p>
        <p class="metric-value">
          <% if addon_without == addon_with %>
            <%= brl(addon_without) %>
          <% else %>
            <%= brl(addon_without) %> – <%= brl(addon_with) %>
          <% end %>
        </p>
        <p class="metric-hint">
          <%= addon_without == addon_with ? "Igual nas duas hipóteses de antecipação" :
            "Intervalo pendente da definição de antecipação" %>
        </p>
      </article>
    </section>

    <section class="table-frame" data-controller="sticky-table">
      <div class="table-toolbar">
        <div>
          <p class="section-label">Subcanais</p>
          <h2 class="table-title">Ganho por subcanal na janela</h2>
        </div>
        <span class="badge badge-ghost"><%= @window.map { |p| l(p, format: "%b/%Y") }.join(" · ") %></span>
      </div>
      <div class="table-scroll">
        <table class="table">
          <thead>
            <tr>
              <th>Subcanal</th>
              <%# M0 é o próprio mês de credenciamento escolhido; o mês de calendário ao
                  lado desfaz qualquer ambiguidade. %>
              <% @window.each_with_index do |period, index| %>
                <th class="text-right">M<%= index %> · <%= l(period, format: "%b/%Y") %></th>
              <% end %>
              <th class="text-right">ECs no M0</th>
              <th class="text-right">Prêmio da safra</th>
            </tr>
          </thead>
          <tbody>
            <% @reports.each do |report| %>
              <tr>
                <td>
                  <%# Leva o M0, não o fim da janela: passar o último mês abriria o
                      subcanal numa janela diferente da que está na tela. %>
                  <%= link_to report[:name],
                    three_months_sub_channel_report_path(id: report[:uuid],
                      start_period: @window.first.strftime("%Y-%m"), channel_id: @selected_channel&.uuid),
                    class: "link" %>
                </td>
                <% report[:months].each do |month| %>
                  <td class="text-right tabular-nums">
                    <% if month[:covered] %>
                      <%= brl(month[:total]) %>
                      <% if month[:partial] %><span class="badge badge-ghost">parcial</span><% end %>
                      <p class="metric-hint">D <%= brl(month[:debit]) %> · C <%= brl(month[:credit]) %></p>
                    <% else %>
                      <span class="metric-hint">sem dado</span>
                    <% end %>
                  </td>
                <% end %>
                <td class="text-right tabular-nums"><%= report[:prize][:accredited] %></td>
                <td class="text-right tabular-nums font-semibold">
                  <% prize = report[:prize] %>
                  <% if prize[:accredited].zero? %>
                    —
                  <% elsif prize[:addon_without_auto] == prize[:addon_with_auto] %>
                    <%= brl(prize[:digitalization] + prize[:addon_without_auto]) %>
                  <% else %>
                    <%= brl(prize[:digitalization] + prize[:addon_without_auto]) %> –
                    <%= brl(prize[:digitalization] + prize[:addon_with_auto]) %>
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
        <% if @reports.empty? %>
          <div class="empty-state">Nenhum volume mensal na janela escolhida.</div>
        <% end %>
      </div>
    </section>
  <% else %>
    <section class="table-frame">
      <div class="empty-state">
        Sem volumes mensais importados ainda — a página 3M depende das colunas de volume da
        planilha (débito e crédito por competência).
      </div>
    </section>
  <% end %>
</div>
