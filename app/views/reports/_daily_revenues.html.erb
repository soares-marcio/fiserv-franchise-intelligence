<%# Conteúdo do modal: o frame é o mesmo da tela de subcanal, então o Turbo troca só isto. %>
<%= turbo_frame_tag "daily_revenues" do %>
  <div class="daily-modal__head">
    <p class="section-label">Lançamentos diários</p>
    <h2 class="table-title">EC <%= @establishment.ec %></h2>
    <% if @window %>
      <p class="page-description">
        Mês inteiro de cada competência, como a planilha entrega.
        O mês atual vai até o dia <%= @window.max_day %> de cobertura.
      </p>
    <% end %>
  </div>

  <% if @rows.any? %>
    <%# Uma coluna por competência, da mais antiga para a mais nova. A lista vem da janela
        porque a penúltima só existe quando foi importada — o laço evita repetir a mesma
        célula três vezes no cabeçalho, no corpo e no rodapé. %>
    <% colunas = @window.daily_columns.map { |period, key| [ period, key, Time.days_in_month(period.month, period.year) ] } %>
    <div class="table-scroll" role="region" tabindex="0"
      aria-label="Faturamento diário do EC <%= @establishment.ec %>">
      <table class="table">
        <caption class="sr-only">
          Faturamento por dia do EC <%= @establishment.ec %>, uma coluna por competência
        </caption>
        <thead>
          <tr>
            <th scope="col">Dia</th>
            <% colunas.each do |period, _key, _dias| %>
              <th scope="col" class="text-right"><%= period_option_label(period) %></th>
            <% end %>
          </tr>
        </thead>
        <tbody>
          <% @rows.each do |row| %>
            <% day = row["day"].to_i %>
            <tr>
              <th scope="row" class="font-mono"><%= format("%02d", day) %></th>
              <% colunas.each do |_period, key, dias_no_mes| %>
                <% valor = row[key].to_d %>
                <%# Dia que não existe na competência: travessão, não zero — 31 de setembro
                    não é "sem venda". %>
                <td class="text-right tabular-nums <%= "opacity-40" if valor.zero? %>">
                  <%= day > dias_no_mes ? "—" : brl(valor) %>
                </td>
              <% end %>
            </tr>
          <% end %>
        </tbody>
        <tfoot>
          <tr>
            <th scope="row">Total no período</th>
            <% colunas.each do |_period, key, _dias| %>
              <td class="text-right tabular-nums">
                <%= brl(@rows.sum { |row| row[key].to_d }) %>
              </td>
            <% end %>
          </tr>
        </tfoot>
      </table>
    </div>
  <% else %>
    <p class="empty-state">Sem competência importada para este Master.</p>
  <% end %>
<% end %>
