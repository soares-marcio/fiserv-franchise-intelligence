<% content_for :title, "Clover Capital" %>

<div class="grid grid-cols-1 gap-5">
  <section class="page-hero">
    <div class="relative z-10 flex flex-wrap items-start justify-between gap-6">
      <div>
        <p class="eyebrow">Oferta de capital</p>
        <h1 class="page-title">Clover Capital</h1>
        <p class="page-description">
          Ofertas pré-aprovadas da aba Mapa de Clientes BIN: volume, prazo, taxa e parcela.
          A oferta é do CNPJ, não do equipamento — cada linha é um cliente, ainda que ele
          tenha vários ECs.
        </p>
      </div>
      <%# O arquivo sai com o recorte que estiver na tela — o MIC escolhido viaja no link,
          senão o download traria a carteira inteira para quem está olhando um MIC só. %>
      <% recorte = { channel_id: @selected_channel&.uuid,
        sub_channel_id: @selected_sub_channel&.uuid }.compact_blank %>
      <div class="export-actions relative z-10 flex flex-wrap gap-2">
        <%= link_to icon_label("download-simple", "Exportar CSV"),
          stalled_reports_path(format: :csv, **recorte), class: "btn btn-outline export-action" %>
        <%= link_to icon_label("download-simple", "Exportar XLSX"),
          stalled_reports_path(format: :xlsx, **recorte), class: "btn btn-neutral export-action" %>
      </div>
    </div>
  </section>

  <%# O MIC saiu da tabela e virou filtro: a coluna repetia o mesmo nome linha após linha e
      empurrava a tabela na horizontal. O canal escolhido viaja escondido para o filtro de
      MIC não o derrubar sem querer. %>
  <section class="filter-panel">
    <%= form_with url: stalled_reports_path, method: :get,
      class: "flex flex-wrap items-end gap-3" do %>
      <% if @selected_channel %>
        <%= hidden_field_tag :channel_id, @selected_channel.uuid %>
      <% end %>
      <label class="grid gap-1.5">
        <span class="section-label">MIC</span>
        <% opcoes = [ [ "Todas", "" ] ] + @sub_channels.map { |mic| [ mic["name"], mic["uuid"] ] } %>
        <%= select_tag :sub_channel_id,
          options_for_select(opcoes, @selected_sub_channel&.uuid),
          class: "select select-bordered w-auto min-w-52 max-w-full" %>
      </label>
      <%= button_tag icon_label("funnel", "Aplicar"), type: "submit",
        class: "btn btn-primary btn--field" %>
    <% end %>
  </section>

  <section class="table-frame" data-controller="sticky-table note-modal">
    <div class="table-toolbar">
      <div>
        <p class="section-label">Pré-aprovado</p>
        <h2 class="table-title">Clientes com oferta</h2>
      </div>
      <div class="flex flex-wrap items-center gap-2">
        <span class="badge badge-ghost">
          <%= pluralize(@reports.size, "cliente", "clientes") %>
        </span>
        <% if @diverging_cnpjs.any? %>
          <span class="badge badge-ghost tooltip tooltip-left" tabindex="0"
            data-tip="Os ECs deste cliente trazem ofertas diferentes; a linha mostra a maior">
            <%= pluralize(@diverging_cnpjs.size, "oferta divergente", "ofertas divergentes") %> entre ECs
          </span>
        <% end %>
        <%# Razão social divergente: no arquivo há EC que traz o nome fantasia na coluna da
            razão. A linha fica com o nome que a maioria dos ECs declara, e o aviso diz que
            houve escolha. %>
        <% if @diverging_name_cnpjs.any? %>
          <span class="badge badge-ghost tooltip tooltip-left" tabindex="0"
            data-tip="Os ECs deste cliente declaram razões sociais diferentes; a linha mostra a que a maioria traz">
            <%= pluralize(@diverging_name_cnpjs.size, "razão social divergente", "razões sociais divergentes") %>
          </span>
        <% end %>
      </div>
    </div>

    <div class="table-scroll" role="region" tabindex="0"
      aria-label="Ofertas pré-aprovadas, rolável na horizontal">
      <table class="table">
        <thead>
          <tr>
            <th scope="col">Estabelecimento</th>
            <th scope="col" class="text-right">Volume pré-aprovado</th>
            <th scope="col" class="text-right">Prazo pré-aprovado</th>
            <th scope="col" class="text-right">Taxa pré-aprovada</th>
            <th scope="col" class="note-col">Anotação</th>
          </tr>
        </thead>
        <tbody>
          <% @reports.each do |report| %>
            <tr>
              <td>
                <p class="font-mono text-xs whitespace-nowrap"><%= formatted_cnpj(report["cnpj"]) %></p>
                <p class="font-semibold"><%= present_or_dash(report["legal_name"]) %></p>
                <% if report["establishments"].to_i > 1 %>
                  <p class="text-xs opacity-60">
                    <%= pluralize(report["establishments"], "EC", "ECs") %> neste CNPJ
                  </p>
                <% end %>
                <%# O MIC saiu da tabela como coluna e voltou aqui como informação de rodapé
                    da célula: quem lê a linha sabe de onde o cliente é, sem uma coluna
                    repetindo o mesmo nome e empurrando a tabela na horizontal. %>
                <p class="text-xs opacity-60"><%= present_or_dash(report["sub_channels"]) %></p>
              </td>
              <td class="text-right tabular-nums"><%= brl(report["preapproved_volume"]) %></td>
              <td class="text-right tabular-nums">
                <%= report["preapproved_term"].present? ? pluralize(report["preapproved_term"], "mês", "meses") : "—" %>
              </td>
              <td class="text-right tabular-nums">
                <%= report["preapproved_rate"].present? ? number_to_percentage(report["preapproved_rate"], precision: 2) : "—" %>
              </td>
              <td class="note-col">
                <%= render "shared/company_note_cell",
                  company_uuid: report["company_uuid"],
                  name: report["legal_name"].to_s,
                  note_id: report["note_id"], note_updated_at: report["note_updated_at"],
                  note_params: { channel_id: @selected_channel&.uuid,
                    sub_channel_id: @selected_sub_channel&.uuid }.compact_blank %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
      <% if @reports.empty? %>
        <div class="empty-state">Nenhum cliente com oferta pré-aprovada no arquivo importado.</div>
      <% end %>
    </div>

    <%= render "shared/company_note_modal" %>
  </section>
</div>
