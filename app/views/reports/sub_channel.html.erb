<% content_for :title, @sub_channel.name %>

<% caminho_da_ordem = ->(ordem) { sub_channel_report_path(@sub_channel, sub_channel_listing_params(**ordem)) } %>

<div class="grid grid-cols-1 gap-5">
  <section class="page-hero">
    <div class="relative z-10 flex flex-wrap items-start justify-between gap-6">
      <div>
        <p class="eyebrow">Visão comercial</p>
        <h1 class="page-title"><%= channel_name(@sub_channel.channel) %></h1>
        <% if @window %>
          <p class="page-description">
            Um cliente por linha, somando o faturamento de todos os ECs do CNPJ. O mês
            anterior aparece completo. A variação compara períodos equivalentes
            <strong><%= day_range_label(@from_day, @to_day) %></strong>
            da competência <%= period_option_label(@period) %>.
            Os lançamentos diários abrem no detalhe de cada estabelecimento.
          </p>
        <% else %>
          <p class="page-description">Importe um arquivo validado para começar a acompanhar a carteira.</p>
        <% end %>
      </div>
      <div class="export-actions relative z-10 flex flex-wrap gap-2">
        <%# A exportação leva o recorte da tela — filtros, busca e aba —, sem a paginação. %>
        <% export_params = sub_channel_listing_params(page: nil, per_page: nil) %>
        <%= link_to icon_label("download-simple", "Exportar CSV"),
          sub_channel_report_path(@sub_channel, export_params.merge(format: :csv)),
          class: "btn btn-outline export-action" %>
        <%= link_to icon_label("download-simple", "Exportar XLSX"),
          sub_channel_report_path(@sub_channel, export_params.merge(format: :xlsx)),
          class: "btn btn-neutral export-action" %>
        <%= link_to "Voltar à listagem", reports_path(channel_id: @selected_channel&.uuid),
          class: "btn btn-outline" %>
      </div>
    </div>

    <% if @window %>
      <div class="metric-grid metric-grid--5 relative z-10">
        <article class="metric-card" data-tone="teal">
          <p class="metric-label">Mês anterior cheio</p>
          <p class="metric-value"><%= brl_metric(@totals[:previous_full_revenue]) %></p>
          <p class="metric-hint">Competência fechada</p>
        </article>
        <article class="metric-card" data-tone="gold">
          <p class="metric-label">Base comparável</p>
          <p class="metric-value"><%= brl_metric(@totals[:previous_revenue]) %></p>
          <p class="metric-hint">Mês anterior <%= day_range_label(@from_day, @to_day) %></p>
        </article>
        <article class="metric-card" data-tone="green">
          <p class="metric-label">Mês atual</p>
          <p class="metric-value"><%= brl_metric(@totals[:current_revenue]) %></p>
          <p class="metric-hint"><%= period_option_label(@period) %>,
            <%= day_range_label(@from_day, @to_day) %></p>
        </article>
        <article class="metric-card"
          data-tone="<%= variation_metric_tone(@totals[:previous_revenue], @totals[:current_revenue]) %>">
          <p class="metric-label">Variação alinhada</p>
          <p class="metric-value">
            <%= variation_headline(@totals[:previous_revenue], @totals[:current_revenue]) %>
          </p>
          <%# Os cards somam a aba ativa (decisão do usuário). A variação da aba é
              enviesada por construção, então a verdadeira fica ancorada ao lado. %>
          <% if @selected_variation %>
            <p class="metric-hint">
              Somando só a aba <%= @selected_variation == "alta" ? "Em crescimento" : "Em queda" %>
              (<%= pluralize(@total_count, "estabelecimento", "estabelecimentos") %>)
              <% if (overall = @listing.overall_totals) %>
                · MIC inteiro:
                <strong><%= signed_variation(overall[:previous_revenue], overall[:current_revenue]) %></strong>
              <% end %>
            </p>
          <% else %>
            <p class="metric-hint">Períodos com a mesma duração</p>
          <% end %>
        </article>
        <%# Ticket médio da carteira: mês anterior cheio dividido pelos CNPJs ativos do
            recorte. O divisor fica escrito porque a conta mistura o mês fechado com o
            status de hoje — sem isso, quem lê entende "média de quem vendeu". %>
        <article class="metric-card" data-tone="teal">
          <p class="metric-label">Ticket médio</p>
          <p class="metric-value"><%= @listing.average_ticket ? brl_metric(@listing.average_ticket) : "—" %></p>
          <p class="metric-hint">
            <% ativos = @listing.status_counts["Active"].to_i %>
            <% if ativos.positive? %>
              Mês anterior cheio ÷ <%= pluralize(ativos, "CNPJ ativo", "CNPJs ativos") %>
            <% else %>
              Nenhum CNPJ ativo no recorte
            <% end %>
          </p>
        </article>
      </div>
    <% end %>
  </section>

  <% if @window %>
    <%# Barra em pílulas: cada filtro é um controle só, com o rótulo dentro e o valor à vista.
        Antes eram cinco rótulos em caixa-alta acima de cinco controles de aparências
        diferentes — caixa com chip, botão com ícone, select, alça crua, campo de texto —,
        mais uma linha de chips repetindo o que os controles já diziam. Aqui todos têm a mesma
        forma, a mesma altura e o mesmo peso; quem grita é o valor, não o rótulo. %>
    <section class="filter-panel">
      <%= form_with url: sub_channel_report_path(@sub_channel), method: :get, class: "filter-bar" do %>
        <% if @selected_channel %>
          <%= hidden_field_tag :channel_id, @selected_channel.uuid %>
        <% end %>

        <div class="filter-pill" data-controller="tag-select">
          <div id="status_filter_trigger" class="filter-pill__trigger" role="combobox" tabindex="0"
            data-tag-select-target="trigger" aria-haspopup="listbox" aria-expanded="false"
            aria-controls="status_filter_menu" aria-label="Status do contrato"
            data-action="click->tag-select#toggle keydown->tag-select#keydown">
            <span class="filter-pill__label">Status</span>
            <span class="filter-pill__value" data-tag-select-target="chips"></span>
            <span class="filter-pill__value filter-pill__value--empty"
              data-tag-select-target="placeholder">todos</span>
            <%= icon("caret-down", css: "filter-pill__caret") %>
          </div>
          <div id="status_filter_menu" class="tag-select__menu" data-tag-select-target="menu"
            hidden role="listbox" aria-multiselectable="true"
            aria-labelledby="status_filter_trigger">
            <% @status_options.each do |status| %>
              <label class="tag-select__option <%= "is-selected" if @selected_statuses.include?(status) %>">
                <%= check_box_tag "status[]", status, @selected_statuses.include?(status),
                  id: "status_#{status}",
                  data: {
                    action: "change->tag-select#sync",
                    label: contract_status_label(status),
                    tone: contract_status_tone(status)
                  } %>
                <span><%= contract_status_label(status) %></span>
              </label>
            <% end %>
          </div>
        </div>

        <div class="filter-pill" data-controller="tag-select">
          <div id="date_kind_filter_trigger" class="filter-pill__trigger" role="combobox"
            tabindex="0" data-tag-select-target="trigger" aria-haspopup="listbox"
            aria-expanded="false" aria-controls="date_kind_filter_menu"
            aria-label="Tipo de data" data-action="click->tag-select#toggle keydown->tag-select#keydown">
            <span class="filter-pill__label">Data</span>
            <span class="filter-pill__value" data-tag-select-target="chips"></span>
            <span class="filter-pill__value filter-pill__value--empty"
              data-tag-select-target="placeholder">todas</span>
            <%= icon("caret-down", css: "filter-pill__caret") %>
          </div>
          <div id="date_kind_filter_menu" class="tag-select__menu" data-tag-select-target="menu"
            hidden role="listbox" aria-multiselectable="true"
            aria-labelledby="date_kind_filter_trigger">
            <% EstablishmentsHelper::DATE_KIND_OPTIONS.each do |value, label| %>
              <label class="tag-select__option <%= "is-selected" if @selected_date_kinds.include?(value) %>">
                <%= check_box_tag "date_kind[]", value, @selected_date_kinds.include?(value),
                  id: "date_kind_#{value}",
                  data: {
                    action: "change->tag-select#sync",
                    label:,
                    tone: EstablishmentsHelper::DATE_KIND_TONES.fetch(value)
                  } %>
                <span><%= label %></span>
              </label>
            <% end %>
          </div>
        </div>

        <%= render "reports/date_range_picker", label: "Período",
          from_date: @from_date, to_date: @to_date, open_on: nil, pill: true %>

        <%# O faturamento também é uma pílula: a base e as alças moram no painel, e o gatilho
            diz o recorte por extenso. Sem isso ele seria o único controle da barra com dois
            campos à mostra, e a linha voltaria a ter duas alturas. %>
        <div class="filter-pill filter-pill--revenue" data-controller="revenue-filter"
          data-revenue-filter-stops-value="<%= EstablishmentListingQuery::REVENUE_STOPS.to_json %>">
          <button type="button" id="revenue_filter_trigger" class="filter-pill__trigger"
            data-revenue-filter-target="trigger" aria-haspopup="dialog" aria-expanded="false"
            aria-controls="revenue_filter_panel"
            data-action="click->revenue-filter#toggle">
            <span class="filter-pill__label">Faturamento</span>
            <span class="filter-pill__value <%= "filter-pill__value--empty" if @revenue_basis.nil? %>"
              data-revenue-filter-target="summary">
              <%= revenue_summary(@revenue_basis, @min_revenue, @max_revenue) %>
            </span>
            <%= icon("caret-down", css: "filter-pill__caret") %>
          </button>
          <div id="revenue_filter_panel" class="filter-pill__panel"
            data-revenue-filter-target="panel" hidden role="dialog"
            aria-label="Filtrar por faturamento">
            <label class="filter-pill__panel-label" for="revenue_basis">Competência</label>
            <%= select_tag :revenue_basis,
              options_for_select(EstablishmentsHelper::REVENUE_BASIS_OPTIONS, @revenue_basis),
              id: "revenue_basis", class: "select select-bordered filter-pill__select",
              data: { revenue_filter_target: "basis", action: "change->revenue-filter#sync" } %>
            <div class="filter-pill__panel-head">
              <span class="filter-pill__panel-label">Faixa</span>
              <output id="revenue_range_value" class="filter-pill__amount"
                data-revenue-filter-target="value">
                <%= @revenue_basis ? revenue_range_label(@min_revenue, @max_revenue) : "sem filtro" %>
              </output>
            </div>
            <%# Duas alças são dois campos nativos sobrepostos: não existe range de duas alças
                em HTML. O trilho e a faixa acesa são pintados aqui porque os trilhos nativos
                ficam transparentes no CSS: dois trilhos empilhados apareceriam como duas linhas.

                A alça carrega o **índice da parada**, não o valor: as paradas são espaçadas
                (REVENUE_STOPS) para que a faixa de 0 a R$ 30.000 ocupe 74% do trilho em vez
                de 10%. Quem viaja no formulário é o campo escondido, em reais — a URL e o
                contrato com o servidor não mudam. Sem JavaScript a alça deixa de mexer no
                valor; o campo escondido segue com o que o servidor desenhou. %>
            <div class="revenue-range">
              <span class="revenue-range__track" aria-hidden="true"></span>
              <span class="revenue-range__band" data-revenue-filter-target="band"
                aria-hidden="true"></span>
              <%= tag.input type: "range", id: "min_revenue_slider",
                value: EstablishmentListingQuery.revenue_stop_index(@min_revenue || 0),
                min: 0, max: EstablishmentListingQuery::REVENUE_STOPS.size - 1, step: 1,
                class: "revenue-range__input",
                aria: { label: "Faturamento mínimo", describedby: "revenue_range_value" },
                data: { revenue_filter_target: "min", action: "input->revenue-filter#sync" } %>
              <%= tag.input type: "range", id: "max_revenue_slider",
                value: EstablishmentListingQuery.revenue_stop_index(
                  @max_revenue || EstablishmentListingQuery::LOW_REVENUE_THRESHOLD
                ),
                min: 0, max: EstablishmentListingQuery::REVENUE_STOPS.size - 1, step: 1,
                class: "revenue-range__input",
                aria: { label: "Faturamento máximo", describedby: "revenue_range_value" },
                data: { revenue_filter_target: "max", action: "input->revenue-filter#sync" } %>
            </div>
            <%# As marcas dizem onde o passo muda, e ficam na posição real da parada: igualmente
                espaçadas elas mentiriam, porque R$ 30.000 fica a 73% do trilho e não a 25%. %>
            <div class="revenue-range__marks" aria-hidden="true">
              <% [ 0, EstablishmentListingQuery::LOW_REVENUE_REFERENCE,
                   EstablishmentListingQuery::LOW_REVENUE_THRESHOLD ].each do |parada| %>
                <% posicao = EstablishmentListingQuery.revenue_stop_index(parada) * 100.0 /
                  (EstablishmentListingQuery::REVENUE_STOPS.size - 1) %>
                <span style="left: <%= number_with_precision(posicao, precision: 2) %>%">
                  <%= brl_round(parada) %>
                </span>
              <% end %>
            </div>
            <%= hidden_field_tag :min_revenue, @min_revenue || 0,
              data: { revenue_filter_target: "minValue" } %>
            <%= hidden_field_tag :max_revenue,
              @max_revenue || EstablishmentListingQuery::LOW_REVENUE_THRESHOLD,
              data: { revenue_filter_target: "maxValue" } %>
            <p class="filter-pill__hint">
              "Todas" não filtra. A faixa entra inteira, com as duas pontas: até <%= brl_round(0) %>
              mostra quem não faturou nada.
            </p>
          </div>
        </div>

        <div class="filter-pill filter-pill--search">
          <label class="sr-only" for="establishment_query">Buscar estabelecimento</label>
          <%= icon("magnifying-glass", css: "filter-pill__caret") %>
          <%= search_field_tag :q, @query, id: "establishment_query", class: "filter-pill__input",
            placeholder: "EC, CNPJ, nome ou melhor conversa", autocomplete: "off" %>
        </div>

        <%= hidden_field_tag :period, @period %>
        <%= hidden_field_tag :from_day, @from_day %>
        <%= hidden_field_tag :to_day, @to_day %>
        <%= hidden_field_tag :per_page, @per_page %>

        <div class="filter-actions">
          <%= button_tag icon_label("funnel", "Filtrar"), type: "submit",
            class: "btn btn-primary filter-pill__submit" %>
          <%# O "Limpar" só existe quando há o que limpar: botão permanente para desfazer o
              nada é ruído. %>
          <% if @selected_statuses.any? || @selected_date_kinds.any? || @from_date || @query.present? || @revenue_basis %>
            <%= link_to "Limpar",
              sub_channel_report_path(@sub_channel, channel_id: @selected_channel&.uuid),
              class: "filter-bar__clear" %>
          <% end %>
        </div>
      <% end %>
    </section>
  <% end %>

  <%# Abas por variação alinhada: Baixa concentra quem piorou ou zerou o mês atual;
      estável e cliente novo faturando ficam em Alta. Trocar de aba zera a página. %>
  <% counts = @listing.variation_counts %>
  <%# Cada aba carrega o próprio critério: o rótulo com a contagem e, embaixo, a regra
      do filtro em palavras — quem procura "para onde foi aquele cliente?" lê na barra.
      Desde que a linha é o cliente, a contagem da aba e a da tabela são a mesma coisa. %>
  <div class="variation-tabs-wrap">
  <%# Links de navegação, não um tablist: cada aba troca a página inteira, e a atual se
      anuncia com aria-current. %>
  <nav class="variation-tabs" aria-label="Filtro por variação">
    <%= link_to sub_channel_report_path(@sub_channel, sub_channel_listing_params(variation: nil, page: nil)),
      class: ("is-active" if @selected_variation.nil?),
      aria: { current: ("page" if @selected_variation.nil?) } do %>
      <span class="tab-title">Todos · <%= counts[:todas] %></span>
      <span class="tab-hint">estabelecimentos, um por CNPJ</span>
    <% end %>
    <%= link_to sub_channel_report_path(@sub_channel, sub_channel_listing_params(variation: "alta", page: nil)),
      class: ("is-active" if @selected_variation == "alta"),
      aria: { current: ("page" if @selected_variation == "alta") } do %>
      <span class="tab-title"><%= phosphor_icon(:up) %> Em crescimento · <%= counts[:alta] %></span>
      <span class="tab-hint">vendeu mais, manteve ou é novo</span>
    <% end %>
    <%= link_to sub_channel_report_path(@sub_channel, sub_channel_listing_params(variation: "baixa", page: nil)),
      class: ("is-active" if @selected_variation == "baixa"),
      aria: { current: ("page" if @selected_variation == "baixa") } do %>
      <span class="tab-title"><%= phosphor_icon(:down) %> Em queda · <%= counts[:baixa] %></span>
      <span class="tab-hint">vendeu menos, está sem venda ou voltou do zero</span>
    <% end %>
  </nav>

  </div>

  <section class="table-frame" data-controller="sticky-table daily-modal conversation-modal note-modal"
    data-variation-filter="<%= @selected_variation %>">
    <div class="table-toolbar">
      <div>
        <p class="section-label">Desempenho por estabelecimento</p>
        <h2 class="table-title"><%= @sub_channel.name %></h2>
      </div>
      <%# Quantos clientes do recorte caíram dentro da faixa em cada competência, com o
          destaque que o usuário pediu: bloco próprio entre o título e a paginação, e não uma
          miudeza na linha de contagens. São duas contagens independentes — o mesmo cliente
          costuma estar nas duas —, e por isso a tela nunca as soma. O mês atual é parcial, e
          a dica diz isso: no mês em curso o número cai conforme o arquivo avança.

          A faixa é a mesma que o filtro aplica, piso inclusive (decisão do usuário,
          15/09/2026): antes o bloco só sabia contar até o teto, e com um piso escolhido ele
          anunciaria um número maior que o da tabela ao lado. %>
      <% baixos = @listing.low_revenue_counts %>
      <% if @total_count.to_i.positive? && baixos.present? %>
        <%# O teto vem da consulta, e não recalculado aqui: as duas pontas já divergiram uma
            vez — o bloco anunciava uma faixa diferente da que as contagens usavam. %>
        <% corte = brl_round(baixos[:ceiling]) %>
        <%# O piso formatado como o teto: "R$ 0" cru ao lado de "R$ 30.000,00" formatado usa
            espaços diferentes e desalinha a leitura. %>
        <% piso = brl_round(baixos[:floor]) %>
        <div class="low-revenue" data-tone="gold">
          <p class="section-label">Entre <%= piso %> e <%= corte %></p>
          <div class="low-revenue__numbers">
            <span class="tooltip tooltip-bottom" tabindex="0"
              data-tip="Clientes cujo faturamento do mês anterior cheio ficou entre <%= piso %> e <%= corte %>, incluindo o próprio valor nas duas pontas.">
              <strong><%= baixos[:previous_full].to_i %></strong>
              <span class="low-revenue__label">mês anterior cheio</span>
            </span>
            <span class="tooltip tooltip-bottom" tabindex="0"
              data-tip="Mesma conta no mês atual, que é parcial: vale o que já entrou até o dia <%= @to_day %> de cobertura, então este número muda conforme o mês avança.">
              <strong><%= baixos[:current].to_i %></strong>
              <span class="low-revenue__label">mês atual</span>
            </span>
          </div>
        </div>
      <% end %>

      <% if @total_count.to_i.positive? %>
        <div class="table-toolbar__meta">
          <%# Badge e status contam a mesma coisa: estabelecimentos, um por CNPJ. Eram
              números diferentes enquanto a tabela listava um EC por linha. %>
          <span class="badge badge-ghost"><%= pluralize(@total_count, "estabelecimento", "estabelecimentos") %></span>
          <% status_counts = @listing.status_counts %>
          <% if status_counts.values.sum.positive? %>
            <span class="table-toolbar__breakdown">
              com
              <span class="tooltip tooltip-bottom" tabindex="0"
                data-tip="Cliente com pelo menos um EC ativo. Quem trocou de EC — o antigo suspenso, o novo aberto no lugar — continua contando como ativo.">
                <strong><%= status_counts["Active"].to_i %></strong> ativos
              </span>
              e
              <span class="tooltip tooltip-bottom" tabindex="0"
                data-tip="Cliente com todos os ECs suspensos. Basta um EC ativo para o CNPJ sair desta contagem.">
                <strong><%= status_counts["Suspended"].to_i %></strong> suspensos
              </span>
              <span class="table-toolbar__breakdown-unit">por CNPJ</span>
            </span>
          <% end %>
          <%= render "shared/sort_status", sort: @order, path: caminho_da_ordem %>
          <div class="per-page">
            <span class="section-label">Por página</span>
            <div class="join">
              <% EstablishmentListingQuery::PER_PAGE_OPTIONS.each do |size| %>
                <%= link_to size,
                  sub_channel_report_path(@sub_channel, sub_channel_listing_params(per_page: size, page: 1)),
                  class: "join-item btn btn-sm #{size == @per_page ? "btn-primary" : "btn-outline"}" %>
              <% end %>
            </div>
          </div>
        </div>
      <% end %>
    </div>

    <p class="table-scroll-hint">Deslize a tabela para ver todos os dados.</p>

    <div class="table-scroll" role="region" tabindex="0"
      aria-label="Desempenho por estabelecimento, rolável na horizontal">
      <table class="table establishment-revenue-table">
        <thead>
          <tr>
            <%# A coluna deixou de ser do EC: a linha é o cliente e o EC não aparece mais
                na listagem (pedido do usuário, 10/09/2026). O que sobrou dela é o Net MDR. %>
            <th scope="col">Net MDR</th>
            <th scope="col">Estabelecimento</th>
            <th scope="col">Datas do ciclo</th>
            <%# As três colunas de valor ordenam a listagem: o cabeçalho é compartilhado
                com as demais telas que têm valor. %>

            <% EstablishmentListingQuery::SORT_COLUMNS.each do |column, label| %>
              <%= render "shared/sortable_header", sort: @order, column:, label:,
                path: caminho_da_ordem,
                hint: (column == "previous_full_revenue" ? "competência fechada" : (day_range_label(@from_day, @to_day) if @window)) %>
            <% end %>
            <th scope="col" class="text-right variation-col">Variação</th>
            <th scope="col" class="actions-col">Ações</th>
          </tr>
        </thead>
        <tbody>
          <% @reports.each do |report| %>
            <% previous = report["previous_revenue"].to_d %>
            <% previous_full = report["previous_full_revenue"].to_d %>
            <% current = report["current_revenue"].to_d %>
            <%# A linha inteira abre os lançamentos diários; o nome do cliente é o link, e
                continua sendo o caminho por teclado e para leitor de tela. Era o número do
                EC — que saiu da tela quando a linha passou a ser o cliente. %>
            <tr class="daily-row" data-action="click->daily-modal#openFromRow">
              <%# Só alíquota positiva: "Inativo", zero e negativo não afirmam alíquota
                  nenhuma, e 259 dos 470 ECs da carteira caem num dos três. %>
              <td class="font-mono tabular-nums">
                <%= client_net_mdr_label(report["net_mdr_min"], report["net_mdr_max"]) || "—" %>
              </td>
              <%# O CNPJ mora na célula do estabelecimento, acima do nome: ele é a identidade
                  da linha, e uma coluna própria só custava largura. %>
              <td>
                <p class="font-mono text-xs whitespace-nowrap"><%= formatted_cnpj(report["cnpj"]) %></p>
                <p class="font-semibold">
                  <%= link_to report["trade_name"].presence || report["legal_name"],
                        sub_channel_daily_report_path(
                          @sub_channel, report["company_uuid"],
                          period: @period, from_day: @from_day, to_day: @to_day
                        ),
                        class: "daily-trigger",
                        title: "Ver lançamentos diários",
                        data: { turbo_frame: "daily_revenues", action: "daily-modal#open" } %>
                </p>
                <% if report["legal_name"].present? && report["legal_name"] != report["trade_name"] %>
                  <p class="text-xs opacity-60"><%= report["legal_name"] %></p>
                <% end %>
                <% if report["contract_status"].present? %>
                  <div class="mt-1"><%= contract_status_badge(report["contract_status"]) %></div>
                <% end %>
              </td>
              <td>
                <dl class="lifecycle-dates">
                  <div>
                    <dt>Cred.</dt>
                    <dd><%= format_date(report["accredited_on"]) %></dd>
                  </div>
                  <div>
                    <dt>Ativ.</dt>
                    <dd><%= format_date(report["activated_on"]) %></dd>
                  </div>
                  <div>
                    <dt>Susp.</dt>
                    <dd><%= format_date(report["suspended_on"]) %></dd>
                  </div>
                  <%# Último acesso ao app: a view audit_accreditation_earnings condiciona o
                      prêmio de entrada a ter havido acesso, então a data pertence ao ciclo.

                      A planilha traz horário de Brasília (UTC-3) e a coluna o guarda
                      literalmente, sem conversão — medido na distribuição por hora dos 1.944
                      registros: vale de madrugada (6 registros à 0h, nenhum às 2h) e pico às
                      16h, que é uso humano em horário local, não em UTC. Por isso a leitura
                      correta é a crua: aqui o valor vem do SQL e volta como Time rotulado
                      UTC, e `to_date` devolve o dia da planilha. Pelo model o Rails subtrai
                      3h de um horário que já é local e o dia retrocede em 14 dos 1.944. %>
                  <div>
                    <dt>Uso do app</dt>
                    <dd><%= format_date(report["last_app_access_at"]) %></dd>
                  </div>
                </dl>
              </td>
              <td class="text-right tabular-nums"><%= brl(previous_full) %></td>
              <td class="text-right tabular-nums"><%= brl(previous) %></td>
              <td class="text-right tabular-nums"><%= brl(current) %></td>
              <td class="text-right variation-col">
                <%# Novo de verdade = ativado (ou credenciado, na falta) neste mês ou no
                    anterior; antigo que saiu do zero vira "Voltou a vender". %>
                <% reference_date = report["activated_on"] || report["accredited_on"] %>
                <% novo = if previous.zero? && current.positive?
                     reference_date.present? && reference_date.to_date >= report["previous_period"].to_date
                   end %>
                <%= variation_chip(previous, current, novo:) %>
              </td>
              <%# As duas ações ocupam um único menu: preserva as funções e libera uma coluna
                  inteira. A conversa indisponível continua explícita, sem parecer uma ação
                  que falhou ao abrir. %>
              <td class="actions-col">
                <% conversas = client_conversations(report["best_conversations"]) %>
                <% nome = report["trade_name"].presence || report["legal_name"] %>
                <%# O painel do menu é posicionado por JavaScript quando abre: a tabela
                    rola na horizontal e, por isso, recorta na vertical. Ver o controller. %>
                <details class="actions-menu" data-controller="actions-menu"
                  data-action="toggle->actions-menu#toggle">
                  <summary class="btn btn-sm btn-square actions-menu__trigger"
                    aria-label="Ações para <%= nome %>">
                    <%= icon("caret-down", css: "btn-icon") %>
                  </summary>
                  <div class="actions-menu__list" data-actions-menu-target="list">
                    <%# Vão todas as conversas dos ECs do cliente, rotuladas pelo EC dentro
                        do modal: 116 dos 302 clientes têm mais de um texto diferente, e
                        escolher um esconderia a pendência do outro ponto de venda. %>
                    <%= button_tag type: "button", disabled: conversas.empty?,
                          class: "btn btn-sm actions-menu__item conversation-trigger",
                          title: conversas.any? ? "Ver a melhor conversa" : "Sem melhor conversa no Mapa",
                          aria: { label: conversas.any? ? "Melhor conversa de #{nome}" : "#{nome} não tem melhor conversa" },
                          data: (conversas.any? ? { action: "conversation-modal#open",
                            conversation_modal_items_param: conversas.to_json,
                            conversation_modal_name_param: nome } : {}) do %>
                      <%= icon_label("list-bullets", "Melhor conversa", css: "btn-icon") %>
                    <% end %>
                    <%# A anotação é do CNPJ: cliente com vários ECs abre a mesma nota. %>
                    <%= render "shared/company_note_cell",
                      company_uuid: report["company_uuid"], name: nome,
                      note_id: report["note_id"], note_updated_at: report["note_updated_at"],
                      note_params: sub_channel_listing_params(
                        origin: "sub_channel", sub_channel_id: @sub_channel.uuid
                      ) %>
                  </div>
                </details>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <% if @reports.empty? %>
      <div class="empty-state">
        <% if @query.present? %>
          Nenhum estabelecimento encontrado para “<%= @query %>”.
        <% else %>
          Nenhum faturamento disponível para esta seleção.
        <% end %>
      </div>
    <% elsif @total_pages > 1 %>
      <%= render "shared/pagination", page: @page, total_pages: @total_pages,
        path: ->(numero) { sub_channel_report_path(@sub_channel, sub_channel_listing_params(page: numero)) } %>
    <% end %>

    <%# Lançamentos diários do cliente clicado, somando os ECs dele. O frame nasce vazio e
        o Turbo o preenche. %>
    <dialog class="daily-modal" data-daily-modal-target="dialog"
      aria-label="Lançamentos diários do estabelecimento"
      data-action="click->daily-modal#closeOnBackdrop close->daily-modal#close">
      <div class="daily-modal__body">
        <button type="button" class="btn-toggle daily-modal__close"
          data-action="daily-modal#close" aria-label="Fechar lançamentos diários">
          <%= icon("x", css: "icon") %>
        </button>
        <%= turbo_frame_tag "daily_revenues" do %>
          <p class="empty-state">Carregando lançamentos…</p>
        <% end %>
      </div>
    </dialog>

    <%# Melhor conversa do cliente clicado, uma por EC. Um diálogo só para a tabela inteira:
        o conteúdo vem do botão, então cem linhas não precisam de cem diálogos. %>
    <dialog class="daily-modal daily-modal--narrow" data-conversation-modal-target="dialog"
      aria-label="Melhor conversa do estabelecimento"
      data-action="click->conversation-modal#closeOnBackdrop close->conversation-modal#close">
      <div class="daily-modal__body">
        <button type="button" class="btn-toggle daily-modal__close"
          data-action="conversation-modal#close" aria-label="Fechar a melhor conversa">
          <%= icon("x", css: "icon") %>
        </button>
        <div class="daily-modal__head">
          <p class="section-label">Melhor conversa</p>
          <h3 class="table-title" data-conversation-modal-target="name"></h3>
        </div>
        <div class="conversation-groups" data-conversation-modal-target="groups"></div>
      </div>
    </dialog>

    <%= render "shared/company_note_modal" %>
  </section>

</div>
