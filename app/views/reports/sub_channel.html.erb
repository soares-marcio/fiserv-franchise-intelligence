<% content_for :title, @sub_channel.name %>

<div class="grid gap-5">
  <section class="page-hero">
    <div class="relative z-10 flex flex-wrap items-start justify-between gap-6">
      <div>
        <p class="eyebrow">Visão comercial</p>
        <h1 class="page-title"><%= @sub_channel.name %></h1>
        <% if @window %>
          <p class="page-description">
            Estabelecimentos deste subcanal. O mês anterior aparece completo. A variação
            compara períodos equivalentes
            <strong><%= day_range_label(@from_day, @to_day) %></strong>
            da competência <%= period_option_label(@period) %>.
            Os lançamentos diários abrem no detalhe de cada estabelecimento.
          </p>
        <% else %>
          <p class="page-description">Importe um arquivo validado para começar a acompanhar a carteira.</p>
        <% end %>
      </div>
      <div class="relative z-10 flex flex-wrap gap-2">
        <%= link_to "Voltar à listagem", reports_path(channel_id: @selected_channel&.uuid),
          class: "btn btn-outline" %>
      </div>
    </div>

    <% if @window %>
      <div class="metric-grid relative z-10">
        <article class="metric-card" data-tone="teal">
          <p class="metric-label">Mês anterior cheio</p>
          <p class="metric-value"><%= brl(@totals[:previous_full_revenue]) %></p>
          <p class="metric-hint">Competência fechada</p>
        </article>
        <article class="metric-card" data-tone="gold">
          <p class="metric-label">Base comparável</p>
          <p class="metric-value"><%= brl(@totals[:previous_revenue]) %></p>
          <p class="metric-hint">Mês anterior <%= day_range_label(@from_day, @to_day) %></p>
        </article>
        <article class="metric-card" data-tone="green">
          <p class="metric-label">Mês atual</p>
          <p class="metric-value"><%= brl(@totals[:current_revenue]) %></p>
          <p class="metric-hint"><%= period_option_label(@period) %>,
            <%= day_range_label(@from_day, @to_day) %></p>
        </article>
        <article class="metric-card"
          data-tone="<%= variation_metric_tone(@totals[:previous_revenue], @totals[:current_revenue]) %>">
          <p class="metric-label">Variação alinhada</p>
          <p class="metric-value">
            <%= variation_headline(@totals[:previous_revenue], @totals[:current_revenue]) %>
          </p>
          <%# Os cards somam a aba ativa (decisão do usuário). A variação da aba é
              enviesada por construção, então a verdadeira fica ancorada ao lado. %>
          <% if @selected_variation %>
            <p class="metric-hint">
              Somando só a aba <%= @selected_variation == "alta" ? "Alta" : "Baixa" %>
              (<%= @total_count %> ECs)
              <% if (overall = @listing.overall_totals) %>
                · Subcanal inteiro:
                <strong><%= signed_variation(overall[:previous_revenue], overall[:current_revenue]) %></strong>
              <% end %>
            </p>
          <% else %>
            <p class="metric-hint">Períodos com a mesma duração</p>
          <% end %>
        </article>
      </div>
    <% end %>
  </section>

  <% if @window %>
    <section class="filter-panel">
      <%= form_with url: sub_channel_report_path(@sub_channel), method: :get, class: "filter-bar" do %>
        <% if @selected_channel %>
          <%= hidden_field_tag :channel_id, @selected_channel.uuid %>
        <% end %>

        <div class="filter-field" data-controller="tag-select">
          <span class="section-label">Status do contrato</span>
          <div id="status_filter_trigger" class="tag-select" role="combobox" tabindex="0"
            data-tag-select-target="trigger" aria-haspopup="listbox" aria-expanded="false"
            aria-controls="status_filter_menu"
            data-action="click->tag-select#toggle keydown->tag-select#keydown">
            <span class="tag-select__chips" data-tag-select-target="chips"></span>
            <span class="tag-select__placeholder" data-tag-select-target="placeholder">
              Todos os status
            </span>
            <span class="tag-select__chevron" aria-hidden="true">⌄</span>
          </div>
          <div id="status_filter_menu" class="tag-select__menu" data-tag-select-target="menu"
            hidden role="listbox" aria-multiselectable="true"
            aria-labelledby="status_filter_trigger">
            <% @status_options.each do |status| %>
              <label class="tag-select__option <%= "is-selected" if @selected_statuses.include?(status) %>">
                <%= check_box_tag "status[]", status, @selected_statuses.include?(status),
                  id: "status_#{status}",
                  data: {
                    action: "change->tag-select#sync",
                    label: contract_status_label(status),
                    tone: contract_status_tone(status)
                  } %>
                <span><%= contract_status_label(status) %></span>
              </label>
            <% end %>
          </div>
        </div>

        <div class="filter-field" data-controller="tag-select">
          <span class="section-label">Tipo de data</span>
          <div id="date_kind_filter_trigger" class="tag-select" role="combobox" tabindex="0"
            data-tag-select-target="trigger" aria-haspopup="listbox" aria-expanded="false"
            aria-controls="date_kind_filter_menu"
            data-action="click->tag-select#toggle keydown->tag-select#keydown">
            <span class="tag-select__chips" data-tag-select-target="chips"></span>
            <span class="tag-select__placeholder" data-tag-select-target="placeholder">
              Todas as datas
            </span>
            <span class="tag-select__chevron" aria-hidden="true">⌄</span>
          </div>
          <div id="date_kind_filter_menu" class="tag-select__menu" data-tag-select-target="menu"
            hidden role="listbox" aria-multiselectable="true"
            aria-labelledby="date_kind_filter_trigger">
            <% EstablishmentsHelper::DATE_KIND_OPTIONS.each do |value, label| %>
              <label class="tag-select__option <%= "is-selected" if @selected_date_kinds.include?(value) %>">
                <%= check_box_tag "date_kind[]", value, @selected_date_kinds.include?(value),
                  id: "date_kind_#{value}",
                  data: {
                    action: "change->tag-select#sync",
                    label:,
                    tone: EstablishmentsHelper::DATE_KIND_TONES.fetch(value)
                  } %>
                <span><%= label %></span>
              </label>
            <% end %>
          </div>
        </div>

        <div class="filter-field" data-controller="date-range-picker"
          data-date-range-picker-from-date-value="<%= @from_date %>"
          data-date-range-picker-to-date-value="<%= @to_date %>">
          <span class="section-label">Intervalo da data</span>
          <%= hidden_field_tag :from_date, @from_date,
            data: { date_range_picker_target: "fromDate" } %>
          <%= hidden_field_tag :to_date, @to_date,
            data: { date_range_picker_target: "toDate" } %>
          <button type="button" id="date_range_trigger" class="date-range"
            data-date-range-picker-target="trigger" aria-haspopup="dialog" aria-expanded="false"
            aria-controls="date_range_panel" data-action="click->date-range-picker#toggle">
            <span class="date-range__icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                <rect x="3.5" y="5" width="17" height="15.5" rx="2.2"/>
                <path d="M8 3.5v3.5M16 3.5v3.5M3.5 10h17"/>
              </svg>
            </span>
            <span class="date-range__label" data-date-range-picker-target="triggerLabel">
              <%= iso_range_label(@from_date, @to_date) %>
            </span>
            <span class="tag-select__chevron" aria-hidden="true">⌄</span>
          </button>
          <div id="date_range_panel" class="datepicker" data-date-range-picker-target="panel"
            hidden role="dialog" aria-label="Escolher intervalo de datas">
            <div class="datepicker__nav">
              <button type="button" class="datepicker__nav-btn"
                data-action="click->date-range-picker#prevMonth" aria-label="Mês anterior">
                ‹
              </button>
              <p class="datepicker__month" data-date-range-picker-target="monthLabel"
                aria-live="polite"></p>
              <button type="button" class="datepicker__nav-btn"
                data-action="click->date-range-picker#nextMonth" aria-label="Próximo mês">
                ›
              </button>
            </div>
            <div class="datepicker__grid" data-date-range-picker-target="grid"
              data-action="click->date-range-picker#pick keydown->date-range-picker#navigate"></div>
            <p class="datepicker__hint" data-date-range-picker-target="hint" aria-live="polite"></p>
            <div class="datepicker__actions">
              <button type="button" class="btn btn-ghost btn-sm"
                data-action="click->date-range-picker#clear">Limpar datas</button>
              <button type="button" class="btn btn-primary btn-sm"
                data-action="click->date-range-picker#finish">Concluir</button>
            </div>
          </div>
        </div>

        <div class="filter-field">
          <label class="section-label" for="establishment_query">Buscar estabelecimento</label>
          <%= search_field_tag :q, @query, id: "establishment_query", class: "filter-search",
            placeholder: "EC, CNPJ ou nome", autocomplete: "off" %>
        </div>

        <%= hidden_field_tag :period, @period %>
        <%= hidden_field_tag :from_day, @from_day %>
        <%= hidden_field_tag :to_day, @to_day %>
        <%= hidden_field_tag :per_page, @per_page %>

        <div class="filter-actions">
          <%= button_tag icon_label("funnel", "Filtrar"), type: "submit", class: "btn btn-primary btn--field" %>
          <%= link_to icon_label("eraser", "Limpar"), sub_channel_report_path(@sub_channel, channel_id: @selected_channel&.uuid),
            class: "btn btn-outline btn--field" %>
        </div>
      <% end %>
    </section>
  <% end %>

  <%# Abas por variação alinhada: Baixa concentra quem piorou ou zerou o mês atual;
      estável e EC novo faturando ficam em Alta. Trocar de aba zera a página. %>
  <% counts = @listing.variation_counts %>
  <%# Cada aba carrega o próprio critério: o rótulo com a contagem e, embaixo, a regra
      do filtro em palavras — quem procura "para onde foi aquele EC?" lê na barra. %>
  <div class="variation-tabs-wrap">
  <nav class="variation-tabs" role="tablist" aria-label="Filtro por variação">
    <%= link_to sub_channel_report_path(@sub_channel, sub_channel_listing_params(variation: nil, page: nil)),
      class: ("is-active" if @selected_variation.nil?),
      role: "tab", aria: { selected: @selected_variation.nil? } do %>
      <span class="tab-title">Todas · <%= counts[:todas] %></span>
      <span class="tab-hint">todos os estabelecimentos</span>
    <% end %>
    <%= link_to sub_channel_report_path(@sub_channel, sub_channel_listing_params(variation: "alta", page: nil)),
      class: ("is-active" if @selected_variation == "alta"),
      role: "tab", aria: { selected: @selected_variation == "alta" } do %>
      <span class="tab-title">Alta · <%= counts[:alta] %></span>
      <span class="tab-hint">cresceu, manteve ou é novo</span>
    <% end %>
    <%= link_to sub_channel_report_path(@sub_channel, sub_channel_listing_params(variation: "baixa", page: nil)),
      class: ("is-active" if @selected_variation == "baixa"),
      role: "tab", aria: { selected: @selected_variation == "baixa" } do %>
      <span class="tab-title">Baixa · <%= counts[:baixa] %></span>
      <span class="tab-hint">caiu ou está sem venda</span>
    <% end %>
  </nav>

  <section class="table-frame" data-controller="sticky-table">
    <div class="table-toolbar">
      <div>
        <p class="section-label">Desempenho por estabelecimento</p>
        <h2 class="table-title"><%= @sub_channel.channel.name %></h2>
      </div>
      <% if @total_count.to_i.positive? %>
        <div class="table-toolbar__meta">
          <span class="badge badge-ghost">
            <%= pluralize(@total_count, "estabelecimento", "estabelecimentos") %>
          </span>
          <div class="per-page">
            <span class="section-label">Por página</span>
            <div class="join">
              <% EstablishmentListingQuery::PER_PAGE_OPTIONS.each do |size| %>
                <%= link_to size,
                  sub_channel_report_path(@sub_channel, sub_channel_listing_params(per_page: size, page: 1)),
                  class: "join-item btn btn-sm #{size == @per_page ? "btn-primary" : "btn-outline"}" %>
              <% end %>
            </div>
          </div>
        </div>
      <% end %>
    </div>

    <p class="table-scroll-hint">Deslize a tabela para ver todos os dados.</p>

    <div class="table-scroll">
      <table class="table establishment-revenue-table">
        <thead>
          <tr>
            <th>EC</th>
            <th>CNPJ</th>
            <th>Estabelecimento</th>
            <th>Datas do ciclo</th>
            <th class="text-right">
              Mês anterior cheio
              <span class="block font-normal normal-case tracking-normal opacity-60">competência fechada</span>
            </th>
            <th class="text-right">
              Mês anterior comparável
              <% if @window %>
                <span class="block font-normal normal-case tracking-normal opacity-60"><%= day_range_label(@from_day, @to_day) %></span>
              <% end %>
            </th>
            <th class="text-right">
              Mês atual
              <% if @window %>
                <span class="block font-normal normal-case tracking-normal opacity-60"><%= day_range_label(@from_day, @to_day) %></span>
              <% end %>
            </th>
            <th class="text-right">Variação</th>
          </tr>
        </thead>
        <tbody>
          <% @reports.each do |report| %>
            <% previous = report["previous_revenue"].to_d %>
            <% previous_full = report["previous_full_revenue"].to_d %>
            <% current = report["current_revenue"].to_d %>
            <tr>
              <td class="font-mono"><%= report["ec"] %></td>
              <td class="font-mono text-xs whitespace-nowrap"><%= formatted_cnpj(report["cnpj"]) %></td>
              <td>
                <p class="font-semibold"><%= report["trade_name"].presence || report["legal_name"] %></p>
                <% if report["legal_name"].present? && report["legal_name"] != report["trade_name"] %>
                  <p class="text-xs opacity-60"><%= report["legal_name"] %></p>
                <% end %>
                <% if report["contract_status"].present? %>
                  <div class="mt-1"><%= contract_status_badge(report["contract_status"]) %></div>
                <% end %>
              </td>
              <td>
                <dl class="lifecycle-dates">
                  <div>
                    <dt>Cred.</dt>
                    <dd><%= format_date(report["accredited_on"]) %></dd>
                  </div>
                  <div>
                    <dt>Ativ.</dt>
                    <dd><%= format_date(report["activated_on"]) %></dd>
                  </div>
                  <div>
                    <dt>Susp.</dt>
                    <dd><%= format_date(report["suspended_on"]) %></dd>
                  </div>
                </dl>
              </td>
              <td class="text-right tabular-nums"><%= brl(previous_full) %></td>
              <td class="text-right tabular-nums"><%= brl(previous) %></td>
              <td class="text-right tabular-nums"><%= brl(current) %></td>
              <td class="text-right">
                <%= variation_chip(previous, current) %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <% if @reports.empty? %>
      <div class="empty-state">
        <% if @query.present? %>
          Nenhum estabelecimento encontrado para “<%= @query %>”.
        <% else %>
          Nenhum faturamento disponível para esta seleção.
        <% end %>
      </div>
    <% elsif @total_pages > 1 %>
      <nav class="pagination-bar" aria-label="Paginação">
        <%= link_to "Anterior",
          sub_channel_report_path(@sub_channel, sub_channel_listing_params(page: [ @page - 1, 1 ].max)),
          class: "btn btn-sm btn-outline #{'pointer-events-none opacity-40' if @page <= 1}",
          aria: { disabled: @page <= 1 } %>
        <span class="pagination-bar__status">Página <%= @page %> de <%= @total_pages %></span>
        <%= link_to "Próxima",
          sub_channel_report_path(@sub_channel, sub_channel_listing_params(page: [ @page + 1, @total_pages ].min)),
          class: "btn btn-sm btn-outline #{'pointer-events-none opacity-40' if @page >= @total_pages}",
          aria: { disabled: @page >= @total_pages } %>
      </nav>
    <% end %>
  </section>
  </div>

</div>
