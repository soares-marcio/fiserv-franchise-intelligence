<%# Um card por EC: faturamento da janela e prêmio de credenciamento nas DUAS hipóteses.
    A classificação de antecipação só destaca a provável — nunca decide o valor sozinha. %>
<% accreditation = report[:accreditation] %>
<% ec_window = accreditation && (0..2).map { |offset| accreditation["m0_period"].to_date >> offset } %>
<% in_window = ec_window && (ec_window & window).any? %>
<article class="metric-card" data-tone="teal">
  <p class="metric-label">EC <%= report[:ec] %></p>
  <p class="metric-value text-base"><%= report[:trade_name] || report[:legal_name] || "Sem nome no mapa" %></p>

  <table class="table mt-2">
    <thead>
      <tr>
        <th>Mês</th>
        <th class="text-right">Débito</th>
        <th class="text-right">Crédito</th>
        <th class="text-right">Total</th>
      </tr>
    </thead>
    <tbody>
      <% report[:months].each do |month| %>
        <tr>
          <td><%= l(month[:period], format: "%b/%Y") %><%= " *" if month[:partial] %></td>
          <% if month[:covered] %>
            <td class="text-right tabular-nums"><%= brl(month[:debit]) %></td>
            <td class="text-right tabular-nums"><%= brl(month[:credit]) %></td>
            <td class="text-right tabular-nums font-semibold"><%= brl(month[:total]) %></td>
          <% else %>
            <td colspan="3" class="text-right metric-hint">sem dado</td>
          <% end %>
        </tr>
      <% end %>
    </tbody>
  </table>

  <% if accreditation && in_window %>
    <div class="mt-3 grid gap-1">
      <p class="section-label">Prêmio de credenciamento (M0 = <%= l(accreditation["m0_period"].to_date, format: "%b/%Y") %>)</p>
      <% if accreditation["months_observed"].to_i.zero? %>
        <p class="metric-hint">Janela fora do histórico importado — não apurável, e não é ganho zero.</p>
      <% else %>
        <% highlighted = accreditation["auto_classified"] %>
        <div class="flex flex-wrap gap-3">
          <span class="badge <%= highlighted == false ? "badge-primary" : "badge-ghost" %>">
            Sem antecipação: <%= brl(accreditation["addon_without_auto"].to_f + accreditation["digitalization_amount"].to_f) %>
          </span>
          <span class="badge <%= highlighted == true ? "badge-primary" : "badge-ghost" %>">
            Com antecipação: <%= brl(accreditation["addon_with_auto"].to_f + accreditation["digitalization_amount"].to_f) %>
          </span>
        </div>
        <p class="metric-hint">
          <%= accreditation["months_observed"].to_i %> de 3 meses apurados
          <%= "· inclui R$ 30,00 de digitalização (app em M0)" if accreditation["digitalization_amount"].to_f.positive? %>
          <% if highlighted.nil? %>
            · classificação de antecipação indefinida — os dois cenários valem como hipótese
          <% end %>
        </p>
      <% end %>
    </div>
  <% elsif accreditation %>
    <p class="metric-hint mt-3">
      Credenciado em <%= l(accreditation["accredited_on"].to_date, format: "%d/%m/%Y") %> —
      janela M0/M1/M2 fora do intervalo escolhido.
    </p>
  <% end %>
</article>
