<%# Um card por EC: faturamento da janela e prêmio de credenciamento nas duas hipóteses,
    sem classificar antecipação enquanto a fonte correta não estiver definida. %>
<%# A listagem já traz só ECs credenciados dentro da janela, então o prêmio é sempre
    pertinente aqui; o que varia é quantos meses da janela do EC já têm volume. %>
<% accreditation = report[:accreditation] %>
<% ec_window = accreditation && (0..2).map { |offset| accreditation["m0_period"].to_date >> offset } %>
<article class="metric-card" data-tone="teal">
  <p class="metric-label">EC <%= report[:ec] %></p>
  <p class="metric-value text-base"><%= report[:trade_name] || report[:legal_name] || "Sem nome no mapa" %></p>

  <%# Meses lado a lado: cada coluna é um mês da janela, com débito, crédito e total. %>
  <div class="mt-3 grid grid-cols-3 gap-3">
    <% report[:months].each_with_index do |month, index| %>
      <div class="grid content-start gap-0.5">
        <p class="section-label">M<%= index %> · <%= l(month[:period], format: "%b/%y") %><%= "*" if month[:partial] %></p>
        <% if month[:covered] %>
          <p class="metric-hint tabular-nums">D <%= brl(month[:debit]) %></p>
          <p class="metric-hint tabular-nums">C <%= brl(month[:credit]) %></p>
          <p class="tabular-nums font-semibold"><%= brl(month[:total]) %></p>
        <% else %>
          <p class="metric-hint">sem dado</p>
        <% end %>
      </div>
    <% end %>
  </div>

  <% if accreditation %>
    <div class="mt-3 grid gap-1 border-t border-base-200 pt-3">
      <p class="section-label">
        Prêmio de credenciamento · janela do EC:
        <%= ec_window.map { |period| l(period, format: "%b/%y") }.join(" · ") %>
      </p>
      <% if accreditation["months_observed"].to_i.zero? %>
        <p class="metric-hint">Sem volume importado nessa janela — não apurável, e não é ganho zero.</p>
      <% else %>
        <% fee = accreditation["digitalization_amount"].to_f %>
        <% without_auto = accreditation["addon_without_auto"].to_f %>
        <% with_auto = accreditation["addon_with_auto"].to_f %>
        <%# A coluna do adicional sai da modalidade contratada (SOLUÇÕES FINANCEIRAS): o valor
            é um só. O intervalo sobrevive para o EC cuja origem não declara modalidade — aí a
            apuração não elege coluna nenhuma, e a tela diz isso em vez de escolher. %>
        <% if accreditation["auto_flex"].nil? && without_auto != with_auto %>
          <p class="metric-value text-base"><%= brl(fee) %> <span class="metric-hint">+ adicional</span></p>
          <p class="metric-hint">
            <%= accreditation["months_observed"].to_i %> de 3 meses apurados
            <%= "· R$ 30,00 de digitalização (app em M0)" if fee.positive? %>
            · adicional por faturamento entre <%= brl(without_auto) %> e <%= brl(with_auto) %>,
            porque o arquivo não declara a modalidade deste EC
          </p>
        <% else %>
          <% addon = accreditation["addon_amount"]&.to_f || without_auto %>
          <p class="metric-value text-base"><%= brl(fee + addon) %></p>
          <p class="metric-hint">
            <%= accreditation["months_observed"].to_i %> de 3 meses apurados
            <%= "· R$ 30,00 de digitalização (app em M0)" if fee.positive? %>
            <%# As parcelas dizem em qual mês o prêmio cai — é a apuração sequencial do
                contrato, e é ela que alimenta a base do redutor na tela do recorrente. %>
            <% parcelas = [ "m0", "m1", "m2" ].each_with_index.filter_map do |mes, indice|
                 valor = accreditation["#{mes}_addon_amount"].to_f
                 "M#{indice} #{brl(valor)}" if valor.positive?
               end %>
            <% if parcelas.size > 1 %>
              · por mês: <%= parcelas.join(" · ") %>
            <% end %>
          </p>
        <% end %>
      <% end %>
      <p class="metric-hint">
        Credenciado em <%= l(accreditation["accredited_on"].to_date, format: "%d/%m/%y") %>
      </p>
    </div>
  <% end %>
</article>
