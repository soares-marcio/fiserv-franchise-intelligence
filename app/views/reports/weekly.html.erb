<% content_for :title, "Faturamento semanal" %>

<div class="grid gap-5">
  <section class="page-hero">
    <p class="eyebrow">Ritmo da carteira</p>
    <h1 class="page-title">Faturamento semanal</h1>
    <p class="page-description">
      Semanas de 7 dias a partir do dia 1 da competência. A semana em andamento
      pode ser parcial até o dia de corte<%= @cutoff_day ? " (#{@cutoff_day})" : "" %>.
    </p>
  </section>
  <section class="table-frame" data-controller="sticky-table">
    <div class="table-toolbar">
      <div>
        <p class="section-label">Evolução</p>
        <h2 class="table-title">Movimento por semana</h2>
      </div>
      <% if @reports.any? %>
        <%= render "shared/sort_status", sort: @order,
          path: ->(ordem) { weekly_reports_path(channel_id: @selected_channel&.uuid, **ordem.except(:page)) } %>
      <% end %>
    </div>
    <div class="table-scroll" role="region" tabindex="0"
      aria-label="Faturamento por semana, rolável na horizontal">
      <table class="table">
        <thead>
          <tr>
            <th scope="col">Competência</th>
            <th scope="col">Semana</th>
            <% caminho = ->(ordem) { weekly_reports_path(channel_id: @selected_channel&.uuid, **ordem.except(:page)) } %>
            <%= render "shared/sortable_header", sort: @order, column: "revenue",
              label: "Faturamento", hint: nil, path: caminho %>
            <%= render "shared/sortable_header", sort: @order, column: "establishments",
              label: "ECs com movimento", hint: nil, path: caminho %>
          </tr>
        </thead>
        <tbody>
          <% @reports.each do |report| %>
            <tr>
              <td><%= Date.parse(report["period"].to_s).strftime("%m/%Y") %></td>
              <td><%= report["week"] %></td>
              <td class="text-right tabular-nums"><%= brl(report["revenue"]) %></td>
              <td class="text-right"><%= report["establishments"] %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
      <% if @reports.empty? %>
        <div class="empty-state">Nenhuma série semanal ainda.</div>
      <% end %>
    </div>
  </section>
</div>
