<% content_for :title, "Auditoria de faturamento" %>

<div class="grid grid-cols-1 gap-5">
  <section class="page-hero">
    <p class="eyebrow">Visão comercial</p>
    <h1 class="page-title">Auditoria de faturamento</h1>
    <% if @cutoff_day %>
      <%# Cada MIC até o seu só faz diferença quando os cortes divergem; sem divergência o
          seletor some e a tela fala do corte único, qualquer que seja o da URL. %>
      <% per_sub_channel = @scope.per_sub_channel_cutoff? && @scope.mixed_cutoffs? %>
      <% day_hint = per_sub_channel ? "até o dia de cada MIC (o maior é #{@scope.max_cutoff_day})" : "até dia #{@cutoff_day}" %>
      <p class="page-description">
        O mês anterior aparece completo.
        <% if per_sub_channel %>
          A variação compara cada MIC com o mês anterior até o último dia dele, e o total soma
          essas comparações.
        <% else %>
          A variação compara períodos equivalentes até o <strong>dia <%= @cutoff_day %></strong>,
          último dia com movimento em todos os MICs.
        <% end %>
        <%# Com Masters em dias diferentes, o nome do Master é o que explica o corte; os MICs
            de cada um aparecem ao escolhê-lo no filtro. %>
        <% if @scope.mixed_channel_cutoffs? %>
          Os Masters estão em dias diferentes
          (<%= @scope.cutoffs_by_channel.map { |name, day| "#{name}: dia #{day}" }.join(" · ") %>).
          Escolha um Master no filtro para ver o corte dele.
        <% elsif @scope.mixed_cutoffs? %>
          Os MICs estão em dias diferentes (<%= sub_channel_cutoffs_text(@scope.sub_channel_cutoffs) %>).
        <% end %>
      </p>
      <% if @scope.mixed_cutoffs? %>
        <div class="relative z-10 mt-3 flex flex-wrap items-center gap-2">
          <span class="section-label">Corte</span>
          <div class="join" role="group" aria-label="Dia de corte">
            <% [ [ nil, "Dia #{@cutoff_day} · mesmo dia para todos" ],
                 [ "maior", "Dia #{@scope.max_cutoff_day} · cada MIC até o seu" ] ].each do |value, label| %>
              <%= link_to label,
                reports_path({ channel_id: @selected_channel&.uuid, corte: value,
                  sort: params[:sort], direction: params[:direction] }.compact),
                class: "join-item btn btn-sm #{value == @cutoff_param ? "btn-primary" : "btn-outline"}",
                aria: { current: ("true" if value == @cutoff_param) } %>
            <% end %>
          </div>
        </div>
      <% end %>
    <% else %>
      <p class="page-description">Importe um arquivo validado para começar a acompanhar a carteira.</p>
    <% end %>

    <% if @cutoff_day %>
      <div class="metric-grid relative z-10">
        <article class="metric-card" data-tone="teal">
          <p class="metric-label">Mês anterior cheio</p>
          <p class="metric-value"><%= brl_metric(@totals[:previous_full_revenue]) %></p>
          <p class="metric-hint">Competência fechada</p>
        </article>
        <article class="metric-card" data-tone="gold">
          <p class="metric-label">Base comparável</p>
          <p class="metric-value"><%= brl_metric(@totals[:previous_revenue]) %></p>
          <p class="metric-hint">Mês anterior <%= day_hint %></p>
        </article>
        <article class="metric-card" data-tone="green">
          <p class="metric-label">Mês atual</p>
          <p class="metric-value"><%= brl_metric(@totals[:current_revenue]) %></p>
          <p class="metric-hint">Movimento <%= day_hint %></p>
        </article>
        <article class="metric-card"
          data-tone="<%= variation_metric_tone(@totals[:previous_revenue], @totals[:current_revenue]) %>">
          <p class="metric-label">Variação alinhada</p>
          <p class="metric-value">
            <%= variation_headline(@totals[:previous_revenue], @totals[:current_revenue]) %>
          </p>
          <p class="metric-hint">Períodos com a mesma duração</p>
        </article>
      </div>
    <% end %>
  </section>

  <section class="filter-panel">
    <%= form_with url: reports_path, method: :get,
      class: "filter-bar" do %>
      <div class="filter-pill filter-pill--select">
        <label class="filter-pill__label" for="channel_id">Master</label>
        <%= select_tag :channel_id,
          options_for_select([["todos", ""]] + @channels.map { |channel| [channel_name(channel), channel.uuid] },
            @selected_channel&.uuid),
          class: "filter-pill__native" %>
      </div>
      <%= hidden_field_tag :corte, @cutoff_param if @cutoff_param %>
      <%= button_tag icon_label("funnel", "Filtrar"), type: "submit",
        class: "btn btn-primary filter-pill__submit" %>
      <% if @selected_channel %>
        <%= link_to "Limpar", reports_path, class: "filter-bar__clear" %>
      <% end %>
    <% end %>
  </section>

  <section class="table-frame" data-controller="sticky-table">
    <div class="table-toolbar">
      <div>
        <p class="section-label">Desempenho por carteira</p>
        <h2 class="table-title"><%= channel_name(@selected_channel) || "Todos os MICs" %></h2>
      </div>
      <% if @reports.any? %>
        <div class="table-toolbar__meta">
          <span class="badge badge-ghost"><%= pluralize(@reports.size, "MIC", "MICs") %></span>
          <%= render "shared/sort_status", sort: @order,
            path: ->(order) { reports_path(channel_id: @selected_channel&.uuid, corte: @cutoff_param, **order.except(:page)) } %>
        </div>
      <% end %>
    </div>

    <p class="table-scroll-hint">Deslize a tabela para ver todos os dados.</p>

    <div class="table-scroll" role="region" tabindex="0"
      aria-label="Faturamento por MIC, rolável na horizontal">
      <table class="table">
        <caption class="sr-only">Faturamento por MIC</caption>
        <thead>
          <tr>
            <th scope="col">MIC</th>
            <%# As três colunas de valor ordenam a listagem, como na tela do subcanal. %>
            <% sort_path = ->(order) { reports_path(channel_id: @selected_channel&.uuid, corte: @cutoff_param, **order.except(:page)) } %>
            <% ReportScope::SUB_CHANNEL_SORT_COLUMNS.each do |column, label| %>
              <%= render "shared/sortable_header", sort: @order, column:, label:, path: sort_path,
                hint: (column == "previous_full_revenue" ? "competência fechada" : (day_hint if @cutoff_day)),
                extra_class: ("variation-col" if column == "variation") %>
            <% end %>
          </tr>
        </thead>
        <tbody>
          <% @reports.each do |report| %>
            <% previous = report["previous_revenue"].to_d %>
            <% previous_full = report["previous_full_revenue"].to_d %>
            <% current = report["current_revenue"].to_d %>
            <tr class="is-clickable">
              <td class="font-semibold">
                <%= link_to report["sub_channel_name"],
                  sub_channel_report_path(report["uuid"], { channel_id: @selected_channel&.uuid }.compact),
                  class: "subchannel-link font-semibold", data: { turbo: false } %>
                <% if per_sub_channel && report["max_known_day"].to_i < @scope.max_cutoff_day %>
                  <span class="block text-xs font-normal opacity-70">até dia <%= report["max_known_day"].to_i %></span>
                <% end %>
              </td>
              <td class="text-right tabular-nums"><%= brl(previous_full) %></td>
              <td class="text-right tabular-nums"><%= brl(previous) %></td>
              <td class="text-right tabular-nums"><%= brl(current) %></td>
              <td class="text-right variation-col">
                <%= variation_chip(previous, current) %>
              </td>
            </tr>
          <% end %>
        </tbody>
        <% if @reports.any? %>
          <tfoot>
            <tr class="font-bold">
              <td>Total da seleção</td>
              <td class="text-right tabular-nums"><%= brl(@totals[:previous_full_revenue]) %></td>
              <td class="text-right tabular-nums"><%= brl(@totals[:previous_revenue]) %></td>
              <td class="text-right tabular-nums"><%= brl(@totals[:current_revenue]) %></td>
              <td class="text-right variation-col">
                <%= variation_chip(@totals[:previous_revenue], @totals[:current_revenue]) %>
              </td>
            </tr>
          </tfoot>
        <% end %>
      </table>
    </div>

    <% if @reports.empty? %>
      <div class="empty-state">Nenhum faturamento disponível para esta seleção.</div>
    <% end %>
  </section>
</div>
