<% content_for :title, "Ganhos 3M — #{@sub_channel.name}" %>

<div class="grid grid-cols-1 gap-5">
  <section class="page-hero">
    <div class="relative z-10 flex flex-wrap items-start justify-between gap-6">
      <div>
        <p class="eyebrow">Modelo de remuneração</p>
        <h1 class="page-title"><%= @sub_channel.name %></h1>
        <p class="page-description">
          Estabelecimentos <strong>credenciados no mês escolhido (M0)</strong>, apurados na
          janela deles: M0, M1 e M2 — o modelo dos primeiros 3 meses, com o prêmio de entrada
          de cada EC. O ganho recorrente da carteira vive na página
          <%= link_to "Recorrente", recurring_reports_path, class: "link" %>.
        </p>
      </div>
      <% if @window %>
        <%# O arquivo sai com o recorte da tela: os mesmos parâmetros que o link carrega,
            senão o download traz um recorte diferente do que está à vista. %>
        <% recorte = { id: @sub_channel.uuid, channel_id: @selected_channel&.uuid,
          from_date: @window&.first, to_date: @window&.last }.compact %>
        <div class="export-actions relative z-10 flex flex-wrap gap-2">
          <%= link_to icon_label("download-simple", "Exportar CSV"),
            three_months_sub_channel_report_path(format: :csv, **recorte),
            class: "btn btn-outline export-action" %>
          <%= link_to icon_label("download-simple", "Exportar XLSX"),
            three_months_sub_channel_report_path(format: :xlsx, **recorte),
            class: "btn btn-neutral export-action" %>
        </div>
      <% end %>
    </div>
  </section>

  <section class="filter-panel">
    <%= form_with url: three_months_sub_channel_report_path(id: @sub_channel.uuid), method: :get,
      class: "flex flex-wrap items-end gap-3", data: { controller: "live-form" } do %>
      <%= render "reports/date_range_picker", label: "Intervalo da janela",
        from_date: @window&.first, to_date: @window&.last,
        open_on: @available_periods.first %>
      <%= button_tag icon_label("funnel", "Aplicar"), type: "submit", class: "btn btn-primary btn--field" %>
      <% if @window %>
        <p class="metric-hint self-center">
          Credenciados em <strong><%= l(@window.first, format: "%B de %Y") %></strong>,
          apurados em <%= three_month_window_label(@window.first, @window.last).downcase %>
        </p>
      <% end %>
    <% end %>
  </section>

  <% if @reports.any? %>
    <section class="grid gap-4 sm:grid-cols-2 xl:grid-cols-3">
      <% @reports.each do |report| %>
        <%= render "establishment_earnings_card", report:, window: @window %>
      <% end %>
    </section>
  <% else %>
    <section class="table-frame">
      <div class="empty-state">
        Nenhum estabelecimento credenciado em
        <%= @window ? l(@window.first, format: "%B de %Y") : "no mês escolhido" %>
        neste MIC. Escolha outro mês de credenciamento.
      </div>
    </section>
  <% end %>
</div>
