<% content_for :title, "Ganhos 3M — #{@sub_channel.name}" %>

<div class="grid gap-5">
  <section class="page-hero">
    <p class="eyebrow">Modelo de remuneração</p>
    <h1 class="page-title"><%= @sub_channel.name %></h1>
    <p class="page-description">
      Estabelecimentos <strong>credenciados no mês escolhido (M0)</strong>, apurados na
      janela deles: M0, M1 e M2 — o modelo dos primeiros 3 meses, com o prêmio de entrada
      de cada EC. O ganho recorrente da carteira vive na página
      <%= link_to "Recorrente", recurring_reports_path, class: "link" %>.
    </p>
  </section>

  <section class="filter-panel">
    <%= form_with url: three_months_sub_channel_report_path(id: @sub_channel.uuid), method: :get,
      class: "flex flex-wrap items-end gap-3" do %>
      <label class="grid gap-1.5">
        <span class="section-label">Mês de credenciamento (M0)</span>
        <%= select_tag :start_period,
          options_for_select(@available_periods.map { |period| [three_month_window_label(period), period.strftime("%Y-%m")] },
            @window&.first&.strftime("%Y-%m")),
          class: "select select-bordered w-auto min-w-64 max-w-full" %>
      </label>
      <%= button_tag icon_label("funnel", "Aplicar"), type: "submit", class: "btn btn-primary btn--field" %>
      <% if @window %>
        <p class="metric-hint self-center">
          Credenciados em <strong><%= l(@window.first, format: "%B de %Y") %></strong>,
          apurados em <%= three_month_window_label(@window.first).downcase %>
        </p>
      <% end %>
    <% end %>
  </section>

  <% if @reports.any? %>
    <section class="grid gap-4 sm:grid-cols-2 xl:grid-cols-3">
      <% @reports.each do |report| %>
        <%= render "establishment_earnings_card", report:, window: @window %>
      <% end %>
    </section>
  <% else %>
    <section class="table-frame">
      <div class="empty-state">
        Nenhum estabelecimento credenciado em
        <%= @window ? l(@window.first, format: "%B de %Y") : "no mês escolhido" %>
        neste subcanal. Escolha outro mês de credenciamento.
      </div>
    </section>
  <% end %>
</div>
