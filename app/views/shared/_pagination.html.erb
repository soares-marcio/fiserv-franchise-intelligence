<%# Paginador com os números clicáveis. Antes havia só Anterior e Próxima: ir à página 3
    custava dois cliques, e à última, quinze. O "Página X de Y" saiu porque os números já
    dizem as duas coisas — a atual em laranja cheio, e a última sempre presente no fim.

    Cada bloco de páginas contíguas é um `join`, o mesmo grupo de escolha do "Por página"
    logo acima: é de lá que vem o destaque do selecionado. Botão solto com `.btn` herdaria o
    laranja cheio da regra do sistema e as páginas ficariam todas iguais.

    O caminho vem de quem renderiza, num lambda, porque cada tela tem o seu recorte a
    preservar na URL. %>
<nav class="pagination-bar" aria-label="Paginação">
  <%= link_to icon_label("caret-left", "Anterior"), path.call([ page - 1, 1 ].max),
    class: "btn btn-sm btn-outline #{'pointer-events-none opacity-40' if page <= 1}",
    aria: { disabled: page <= 1 } %>

  <div class="pagination-bar__pages">
    <% pagination_page_groups(page, total_pages).each_with_index do |bloco, indice| %>
      <% if indice.positive? %>
        <span class="pagination-bar__gap" aria-hidden="true">…</span>
      <% end %>
      <div class="join">
        <% bloco.each do |numero| %>
          <% if numero == page %>
            <span class="join-item btn btn-sm btn-primary" aria-current="page"><%= numero %></span>
          <% else %>
            <%= link_to numero, path.call(numero), class: "join-item btn btn-sm btn-outline",
              aria: { label: "Página #{numero}" } %>
          <% end %>
        <% end %>
      </div>
    <% end %>
  </div>

  <%= link_to safe_join([ "Próxima", icon("caret-right", css: "btn-icon") ]),
    path.call([ page + 1, total_pages ].min),
    class: "btn btn-sm btn-outline #{'pointer-events-none opacity-40' if page >= total_pages}",
    aria: { disabled: page >= total_pages } %>
</nav>
