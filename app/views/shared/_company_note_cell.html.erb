<%# Célula da anotação, nas duas telas que a editam. O botão carrega só o endereço do
    formulário — o conteúdo vem por Turbo Frame quando o modal abre.

    O id vem de `company_note_cell_id`: é o endereço da célula para o turbo_stream, que troca
    esta célula ao salvar, sem recarregar a tela. A listagem móvel fornece um id próprio para
    o mesmo CNPJ; o stream troca os dois alvos para não deixar o indicador desatualizado.

    O rótulo é sempre "Anotar"; quem avisa que já há conteúdo é o ponto. Nunca vem `disabled`,
    ao contrário do botão da melhor conversa: lá "não tem" é fato da planilha; aqui é o
    convite para escrever.

    Sem "Ver anotação" não sai nada: o botão abriria um modal que o servidor recusa, e o
    ponto contaria que há anotação a quem não pode lê-la. %>
<% if policy(:company_note).show? %>
<% has_note = note_id.present? %>
<% resolved_cell_id = local_assigns[:cell_id] || company_note_cell_id(company_uuid) %>
<%# Quem só lê não escreve: o botão diz "Ver anotação" e, sem anotação, não há o que abrir. %>
<% can_write = policy(:company_note).edit? %>
<div class="note-cell" id="<%= resolved_cell_id %>">
  <% if can_write %>
  <%= button_tag type: "button",
        class: "btn btn-sm note-trigger #{'btn-outline' unless has_note}",
        title: has_note ? "Ver ou editar a anotação" : "Anotar sobre este cliente",
        aria: { label: "#{has_note ? 'Ver a anotação de' : 'Anotar sobre'} #{name}" },
        data: {
          action: "note-modal#open",
          note_modal_url_param: edit_company_note_path(company_uuid, note_params)
        } do %>
    <%= icon_label("note-pencil", "Anotar") %>
    <% if has_note %>
      <span class="note-trigger__dot" aria-hidden="true"></span>
    <% end %>
  <% end %>
  <% else %>
  <%= button_tag type: "button", disabled: !has_note,
        class: "btn btn-sm note-trigger #{'btn-outline' unless has_note}",
        title: has_note ? "Ver a anotação" : "Sem anotação sobre este cliente",
        aria: { label: has_note ? "Ver a anotação de #{name}" : "#{name} não tem anotação" },
        data: (has_note ? { action: "note-modal#open",
          note_modal_url_param: edit_company_note_path(company_uuid, note_params) } : {}) do %>
    <%= icon_label("eye", "Ver anotação") %>
    <% if has_note %>
      <span class="note-trigger__dot" aria-hidden="true"></span>
    <% end %>
  <% end %>
  <% end %>
  <% if has_note && note_updated_at.present? %>
    <p class="note-cell__date"><%= l(note_updated_at.to_date) %></p>
  <% end %>
</div>
<% end %>
