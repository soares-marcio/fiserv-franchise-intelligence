<header class="topbar">
  <div class="topbar-inner">
    <%= link_to root_path, class: "brand-lockup", aria: { label: "Auditoria BIN — início" } do %>
      <span class="brand-mark" aria-hidden="true"><span></span><span></span><span></span><span></span></span>
      <span>
        <span class="brand-name">Melo Pay</span>
        <span class="brand-caption">Inteligência de franquias</span>
      </span>
    <% end %>

    <nav class="primary-nav" id="primary_nav" aria-label="Navegação principal"
      data-app-layout-target="primaryNav">
      <%# O menu mostra só o que o ator pode abrir: link para tela que responde 403 é
          convite para um erro, e revela o que existe a quem não deveria saber. %>
      <%# Com o menu recolhido, a conta mora na gaveta: quem está agindo no topo e o "Sair"
          no fim, longe dos links. No desktop o CSS esconde os dois e vale o menu da conta. %>
      <% if Current.user %>
        <div class="nav-account">
          <%= render "layouts/account_identity" %>
          <span class="nav-account__email"><%= Current.user.email_address %></span>
        </div>
      <% end %>
      <% report_policy = policy(:report) %>
      <% if report_policy.revenue? %>
      <%= link_to icon_label("chart-line-up", "Faturamento", css: "nav-icon"), reports_path,
        class: nav_link_class({ controller: :reports, actions: %w[index sub_channel] }),
        aria: nav_link_aria({ controller: :reports, actions: %w[index sub_channel] }) %>
      <% end %>
      <% if report_policy.clover? %>
      <%= link_to icon_label("hand-coins", "Clover Capital", css: "nav-icon"), stalled_reports_path,
        class: nav_link_class({ controller: :reports, actions: %w[stalled] }),
        aria: nav_link_aria({ controller: :reports, actions: %w[stalled] }) %>
      <% end %>
      <% if report_policy.weekly? %>
      <%= link_to icon_label("calendar-blank", "Semanal", css: "nav-icon"), weekly_reports_path,
        class: nav_link_class({ controller: :reports, actions: %w[weekly] }),
        aria: nav_link_aria({ controller: :reports, actions: %w[weekly] }) %>
      <% end %>
      <% if report_policy.three_months? %>
      <%= link_to icon_label("calendar-check", "Ganhos 3M", css: "nav-icon"), three_months_reports_path,
        class: nav_link_class({ controller: :reports, actions: %w[three_months three_months_sub_channel] }),
        aria: nav_link_aria({ controller: :reports, actions: %w[three_months three_months_sub_channel] }) %>
      <% end %>
      <% if report_policy.recurring? %>
      <%= link_to icon_label("chart-bar", "Recorrente", css: "nav-icon"), recurring_reports_path,
        class: nav_link_class({ controller: :reports, actions: %w[recurring] }),
        aria: nav_link_aria({ controller: :reports, actions: %w[recurring] }) %>
      <% end %>
      <% if report_policy.indicators? %>
      <%= link_to icon_label("gauge", "Indicadores", css: "nav-icon"), indicators_reports_path,
        class: nav_link_class({ controller: :reports, actions: %w[indicators] }),
        aria: nav_link_aria({ controller: :reports, actions: %w[indicators] }) %>
      <% end %>
      <% if policy(:establishment).index? %>
        <%= link_to icon_label("storefront", "Estabelecimentos", css: "nav-icon"), establishments_path,
          class: nav_link_class({ controller: :establishments }),
          aria: nav_link_aria({ controller: :establishments }) %>
      <% end %>
      <% if policy(:import_batch).index? %>
      <%= link_to import_batches_path, class: nav_link_class({ controller: :import_batches }),
        aria: nav_link_aria({ controller: :import_batches }) do %>
        <%= icon("upload-simple", css: "nav-icon") %>
        Importar arquivo
        <%# Badge com dado real: a idade do último arquivo, do mesmo FileFreshness que o selo
            do cabeçalho usa — uma consulta por página, e os dois nunca divergem. Na tela é só
            o ponto: o texto já está no selo, e repetido ao lado disputava atenção com ele. %>
        <% file_days = file_freshness.received_days %>
        <span class="nav-badge" title="<%= last_file_headline(file_days) %>"
          data-tone="<%= file_days.nil? || file_days >= ImportBatch::STALE_AFTER_DAYS ? 'rose' : 'green' %>">
          <span class="sr-only"><%= last_file_headline(file_days) %></span>
        </span>
      <% end %>
      <% end %>
      <% if policy(:organization).index? %>
        <%= link_to icon_label("buildings", "Organizações", css: "nav-icon"), platform_organizations_path,
          class: nav_link_class({ controller: :organizations }),
          aria: nav_link_aria({ controller: :organizations }) %>
      <% end %>
      <% if policy(:user).index? %>
        <%= link_to icon_label("users", "Acessos", css: "nav-icon"), users_path,
          class: nav_link_class({ controller: :users }),
          aria: nav_link_aria({ controller: :users }) %>
      <% end %>
      <% if policy(:audit_event).index? %>
        <%= link_to icon_label("clock-counter-clockwise", "Histórico", css: "nav-icon"), audit_events_path,
          class: nav_link_class({ controller: :audit_events }),
          aria: nav_link_aria({ controller: :audit_events }) %>
      <% end %>
      <% if policy(:metabase).show? %>
        <%= link_to icon_label("chart-bar", "Metabase", css: "nav-icon"), metabase_path,
          class: nav_link_class({ controller: :metabase }),
          aria: nav_link_aria({ controller: :metabase }) %>
      <% end %>
      <% if Current.user %>
        <div class="nav-account-exit"><%= render "layouts/sign_out" %></div>
      <% end %>
    </nav>

    <div class="topbar-tools">
      <%# A busca e o selo são sinais da carteira: a conta da plataforma não tem carteira, e
          quem não pode buscar não ganha o atalho. %>
      <% if policy(:search).index? %>
        <button class="search-content" type="button" data-action="click->app-layout#openSearch"
          data-app-layout-target="searchTrigger" aria-haspopup="dialog">
          <%= icon("magnifying-glass", css: "icon") %>
          <span class="sr-only">Buscar EC, CNPJ, nome ou MIC</span>
          <span class="search-shortcut" data-app-layout-target="shortcut">Ctrl + /</span>
        </button>
      <% end %>
      <% if Current.organization %>
        <%= render "layouts/file_status" %>
      <% end %>
      <%# Quem está logado e a saída. Sem isto, a única forma de trocar de usuário seria
          apagar cookie na mão — e ninguém sabe em nome de quem está agindo. O "Sair" fica
          dentro do menu, longe de um clique acidental. %>
      <% if Current.user %>
        <details class="account-menu" data-controller="account-menu"
          data-action="toggle->account-menu#toggle">
          <summary class="account-menu__trigger">
            <%= render "layouts/account_identity" %>
            <%= icon("caret-down", css: "account-menu__caret") %>
          </summary>
          <div class="account-menu__panel">
            <span class="account-menu__label">Conectado como</span>
            <span class="account-menu__email"><%= Current.user.email_address %></span>
            <%= render "layouts/sign_out" %>
          </div>
        </details>
      <% end %>
      <%# Último da barra, no HTML e na tela: a gaveta abre colada na borda direita, e o
          botão fica do lado dela. Trocar só a ordem visual desalinharia a ordem do Tab. %>
      <button class="nav-toggle" type="button" data-action="click->app-layout#toggleNav"
        data-app-layout-target="navToggle" aria-expanded="false" aria-controls="primary_nav">
        <%= icon("list", css: "icon") %>
        <span class="sr-only">Abrir ou fechar o menu</span>
      </button>
    </div>
  </div>
</header>

<button class="nav-backdrop" type="button" hidden tabindex="-1"
  data-app-layout-target="navBackdrop" data-action="click->app-layout#closeNavOnBackdrop"
  aria-label="Fechar menu"></button>

<div class="search-modal" data-app-layout-target="searchModal" role="dialog"
  aria-modal="true" aria-labelledby="global-search-title" hidden
  data-action="click->app-layout#closeSearchOnBackdrop">
  <div class="search-modal__dialog">
    <div class="search-modal__header">
      <%= icon("magnifying-glass", css: "icon") %>
      <h2 id="global-search-title">Buscar</h2>
      <button class="btn-toggle" type="button" data-action="click->app-layout#closeSearch"
        aria-label="Fechar busca">
        <%= icon("x", css: "icon") %>
      </button>
    </div>
    <div class="search-modal__field">
      <input type="search" class="search-modal__input" placeholder="EC, CNPJ, nome, cidade, CNAE ou MIC"
        aria-label="Buscar estabelecimentos e MICs" autocomplete="off"
        data-app-layout-target="searchInput"
        data-action="input->app-layout#search keydown->app-layout#searchKeydown">
    </div>
    <div class="search-results">
      <%= turbo_frame_tag "global-search", target: "_top", data: { app_layout_target: "searchResults" } do %>
        <p class="search-hint">Digite ao menos <%= GlobalSearch::MIN_LENGTH %> caracteres: EC, CNPJ, nome, cidade, CNAE ou MIC.</p>
      <% end %>
    </div>
  </div>
</div>
