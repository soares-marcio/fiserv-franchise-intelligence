<header class="header-container">
  <div class="header container-xxl">
    <div class="header-item theme-brand">
      <%= link_to root_path, class: "brand-lockup", aria: { label: "Auditoria BIN - início" } do %>
        <span class="brand-logo" aria-hidden="true">
          <span></span><span></span><span></span><span></span>
        </span>
        <span class="theme-text">Auditoria BIN</span>
      <% end %>

      <button class="btn-toggle sidebar-collapse xl:hidden" type="button"
        data-action="click->cork-layout#toggleMobileMenu" aria-label="Abrir menu">
        <svg xmlns="http://www.w3.org/2000/svg" class="icon icon-tabler icon-tabler-menu-2"
          viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
          stroke-linecap="round" stroke-linejoin="round">
          <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
          <path d="M4 6h16"/><path d="M4 12h16"/><path d="M4 18h16"/>
        </svg>
      </button>
    </div>

    <div class="header-item search-area">
      <button class="search-content" type="button" data-action="click->cork-layout#openSearch"
        data-cork-layout-target="searchTrigger" aria-haspopup="dialog">
        <svg xmlns="http://www.w3.org/2000/svg" class="icon icon-tabler icon-tabler-search"
          viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
          stroke-linecap="round" stroke-linejoin="round">
          <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
          <circle cx="10" cy="10" r="7"/><path d="M21 21l-6 -6"/>
        </svg>
        <span class="search-placeholder">Buscar EC, CNPJ, nome ou subcanal…</span>
        <span class="search-shortcut" data-cork-layout-target="shortcut">Ctrl + /</span>
      </button>
    </div>

    <div class="header-item action-area">
      <%= header_file_status %>
    </div>
  </div>
</header>

<aside class="sidebar-wrapper sidebar-theme">
  <div class="mobile-sidebar-header">
    <%= link_to root_path, class: "brand-lockup", aria: { label: "Auditoria BIN - início" } do %>
      <span class="brand-logo" aria-hidden="true">
        <span></span><span></span><span></span><span></span>
      </span>
      <span class="theme-text">Auditoria BIN</span>
    <% end %>
    <button class="btn-toggle" type="button" data-action="click->cork-layout#closePanels"
      aria-label="Fechar menu">
      <svg xmlns="http://www.w3.org/2000/svg" class="icon icon-tabler icon-tabler-x"
        viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
        stroke-linecap="round" stroke-linejoin="round">
        <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
        <path d="M18 6l-12 12"/><path d="M6 6l12 12"/>
      </svg>
    </button>
  </div>

  <nav class="sidebar-menu" aria-label="Navegação principal">
    <p class="menu-heading">Dashboard</p>
    <%= link_to "Faturamento", reports_path,
      class: sidebar_link_class({ controller: :reports, actions: %w[index] }) %>
    <%= link_to "Clientes parados", stalled_reports_path,
      class: sidebar_link_class({ controller: :reports, actions: %w[stalled] }) %>
    <%= link_to "Semanal", weekly_reports_path,
      class: sidebar_link_class({ controller: :reports, actions: %w[weekly] }) %>

    <p class="menu-heading">Operação</p>
    <%= link_to "Estabelecimentos", establishments_path,
      class: sidebar_link_class({
        controller: :establishments, actions: %w[index show]
      }) %>
    <%= link_to "Importar arquivo", import_batches_path,
      class: sidebar_link_class({ controller: :import_batches }) %>
    <%= link_to "Metabase", metabase_path,
      class: sidebar_link_class({ controller: :metabase }) %>
  </nav>
</aside>

<div class="search-modal" data-cork-layout-target="searchModal" role="dialog"
  aria-modal="true" aria-labelledby="global-search-title" hidden>
  <div class="search-modal__dialog">
    <div class="search-modal__header">
      <svg xmlns="http://www.w3.org/2000/svg" class="icon icon-tabler icon-tabler-search"
        viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
        stroke-linecap="round" stroke-linejoin="round">
        <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
        <circle cx="10" cy="10" r="7"/><path d="M21 21l-6 -6"/>
      </svg>
      <h2 id="global-search-title">Buscar</h2>
      <button class="btn-toggle" type="button" data-action="click->cork-layout#closeSearch"
        aria-label="Fechar busca">
        <svg xmlns="http://www.w3.org/2000/svg" class="icon icon-tabler icon-tabler-x"
          viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
          stroke-linecap="round" stroke-linejoin="round">
          <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
          <path d="M18 6l-12 12"/><path d="M6 6l12 12"/>
        </svg>
      </button>
    </div>
    <div class="search-modal__field">
      <input type="search" class="search-modal__input" placeholder="EC, CNPJ, nome, cidade, CNAE ou subcanal"
        aria-label="Buscar estabelecimentos e subcanais" autocomplete="off"
        data-cork-layout-target="searchInput"
        data-action="input->cork-layout#search keydown->cork-layout#searchKeydown">
    </div>
    <div class="search-results">
      <%= turbo_frame_tag "global-search", target: "_top", data: { cork_layout_target: "searchResults" } do %>
        <p class="search-hint">Digite ao menos <%= GlobalSearch::MIN_LENGTH %> caracteres: EC, CNPJ, nome, cidade, CNAE ou subcanal.</p>
      <% end %>
    </div>
  </div>
</div>
