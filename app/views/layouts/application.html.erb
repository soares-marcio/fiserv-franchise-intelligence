<!DOCTYPE html>
<html lang="pt-BR" data-theme="bin">
  <head>
    <title><%= content_for(:title) || "Auditoria BIN" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Auditoria BIN">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body class="app-body min-h-screen">
    <%= render "layouts/navbar" %>
    <main class="app-main <%= content_for(:container_width) || "" %>">
      <% if notice.present? %>
        <div class="alert alert-success app-alert mb-4" role="status"><%= notice %></div>
      <% end %>
      <% if alert.present? %>
        <div class="alert alert-error app-alert mb-4" role="alert"><%= alert %></div>
      <% end %>
      <%= yield %>
    </main>
  </body>
</html>
