<!DOCTYPE html>
<html lang="pt-BR" data-theme="bin">
  <head>
    <title><%= content_for(:title) || "Auditoria BIN" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Auditoria BIN">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= turbo_refreshes_with method: :morph, scroll: :preserve %>
    <%= yield :head %>
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body class="app-body min-h-screen" data-controller="app-layout"
    data-app-layout-search-url-value="<%= search_path %>">
    <a class="skip-link" href="#main-content">Pular para o conteúdo principal</a>
    <% if staging? %>
      <p class="env-banner" role="status">
        Homologação — cópia dos dados, não é o ambiente de produção
      </p>
    <% end %>
    <%= render "layouts/navbar" %>
    <main id="main-content" class="app-main">
      <%= render_breadcrumbs %>

      <%# Nos últimos dias a própria pessoa é avisada: o portal não manda e-mail, e o vencimento
          a pegaria de surpresa no meio do trabalho. %>
      <% if access_expiring_soon?(Current.user) %>
        <p class="alert alert-warning app-alert mb-4 access-expiry-banner" role="status">
          Seu acesso <%= access_validity_text(Current.user) %>. Para renovar, fale com quem administra os acessos.
        </p>
      <% end %>
      <div id="flash" aria-live="polite">
        <%= render "layouts/flash", notice:, alert: %>
      </div>
      <%= yield %>
    </main>
  </body>
</html>
