<!DOCTYPE html>
<html lang="pt-BR" data-theme="bin">
  <head>
    <title><%= content_for(:title) || "Auditoria BIN" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Auditoria BIN">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= turbo_refreshes_with method: :morph, scroll: :preserve %>
    <%= yield :head %>
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body class="app-body min-h-screen" data-controller="app-layout"
    data-app-layout-search-url-value="<%= search_path %>">
    <a class="skip-link" href="#main-content">Pular para o conteúdo principal</a>
    <%= render "layouts/navbar" %>
    <main id="main-content" class="app-main">
      <%= render_breadcrumbs %>

      <div id="flash" aria-live="polite">
        <%= render "layouts/flash", notice:, alert: %>
      </div>
      <%= yield %>
    </main>
  </body>
</html>
