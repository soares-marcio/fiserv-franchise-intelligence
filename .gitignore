# See https://help.github.com/articles/ignoring-files for more about ignoring files.
#
# Temporary files generated by your text editor or operating system
# belong in git's global ignore instead:
# `$XDG_CONFIG_HOME/git/ignore` or `~/.config/git/ignore`

# Ignore bundler config and vendored gems (install from Gemfile.lock).
/.bundle
/vendor/bundle

# Ignore all environment files except the example.
/.env*
!/.env.example

# Ignora arquivos temporários de bloqueio criados pelo LibreOffice.
/.~lock.*#

# Ignore all logfiles and tempfiles.
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep

# Ignore pidfiles, but keep the directory.
/tmp/pids/*
!/tmp/pids/
!/tmp/pids/.keep

# Ignore storage (uploaded files in development and any SQLite databases).
/storage/*
!/storage/.keep
/tmp/storage/*
!/tmp/storage/
!/tmp/storage/.keep

/public/assets

# Ignore key files for decrypting credentials and more.
/config/*.key


/app/assets/builds/*
!/app/assets/builds/.keep

# Planilhas BIN da Fiserv contêm dados de clientes (CNPJ, telefone, endereço, faturamento).
# Nunca versionar: o arquivo fica só no disco local até termos armazenamento de objetos.
/*.xlsx
/*.xls
