DB_HOST=127.0.0.1
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
METABASE_RO_PASSWORD=defina_uma_senha_forte
SECRET_KEY_BASE=gere_com_bin_rails_secret
# IP desta máquina na LAN, onde o Caddy (em outra máquina) encontra web e metabase.
# Sem definir, as portas ficam só em 127.0.0.1.
APP_BIND_IP=10.0.0.15
# Endereço do Metabase como as máquinas da rede o alcançam (servido pelo Caddy).
METABASE_URL=http://fiserv-metabase.bin
# Nomes extras aceitos no cabeçalho Host, separados por vírgula (fiserv.bin e localhost já valem).
RAILS_HOSTS=
