DB_HOST=127.0.0.1
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
METABASE_RO_PASSWORD=defina_uma_senha_forte
SECRET_KEY_BASE=gere_com_bin_rails_secret
# No berry, onde o portal roda: ativa a sobreposição sem porta no host e com a rede do Caddy.
# Fora dele, deixe comentado — o Mac usa só o docker-compose.yml.
# COMPOSE_FILE=docker-compose.yml:docker-compose.berry.yml
# Marca a máquina como homologação: põe a faixa "Homologação" no topo de toda tela. Só o
# Mac define; no berry (produção) fica sem definir.
# APP_ENVIRONMENT=staging
# IP desta máquina na LAN, onde um Caddy em outra máquina encontraria web e metabase. Só
# vale para quem publica porta no host (não é o caso do berry). Sem definir, 127.0.0.1.
# APP_BIND_IP=10.0.0.15
# Endereço do Metabase como as máquinas da rede o alcançam (servido pelo Caddy). Fica sem
# definir enquanto o Metabase estiver desligado (ver "Build futuro: Metabase" no README).
# METABASE_URL=http://fiserv-metabase.bin
# Nomes extras aceitos no cabeçalho Host, separados por vírgula (fiserv.bin e localhost já valem).
# É por aqui que entra o nome público servido pelo Cloudflare Tunnel — o Host original chega
# ao Rails, e sem o nome na lista ele responde 403. No berry: manager.melopay.com.br
RAILS_HOSTS=
# Onde bin/db-backup grava (fora do repositório: são dados reais de cliente) e por
# quantos dias os arquivos ficam. Prefira caminho absoluto: o agendamento (cron no berry,
# launchd no Mac) não roda a partir do repositório, e o relativo depende do diretório de
# trabalho. No berry: /home/soares/fiserv-storage/backups.
BACKUP_DIR=/caminho/absoluto/para/franchise-storage/backups
BACKUP_KEEP_DAYS=14
# Banco do dump; sem definir, é o de development — que é o servido pela stack.
BACKUP_DB_NAME=fiserv_franchise_intelligence_development
