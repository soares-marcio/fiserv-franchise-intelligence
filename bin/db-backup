#!/bin/bash -e

# Backup do que não se reconstrói a partir do repositório: o banco (faturamento apurado),
# as planilhas importadas (dados de cliente, que por decisão não são apagadas) e as
# perguntas e dashboards do Metabase. O destino fica fora do repositório porque o conteúdo
# é dado real de cliente e nunca pode ser versionado.
#
# Restauração e agendamento: ver "Backup e restauração" no README.

cd "$(dirname "$0")/.."

# Mesmas variáveis que o Compose lê; o shell não as herda sozinho.
if [ -f .env ]; then
  set -a
  # shellcheck disable=SC1091
  . ./.env
  set +a
fi

BACKUP_DIR="${BACKUP_DIR:-../franchise-storage/backups}"
BACKUP_KEEP_DAYS="${BACKUP_KEEP_DAYS:-14}"
DB_NAME="${BACKUP_DB_NAME:-fiserv_franchise_intelligence_development}"
PROJECT="fiserv-franchise-intelligence"
PREFIX="fiserv_$(date +%Y%m%d-%H%M%S)"

mkdir -p "$BACKUP_DIR"
BACKUP_DIR="$(cd "$BACKUP_DIR" && pwd)"

archive_volume() {
  docker run --rm \
    -v "${PROJECT}_$1:/data:ro" -v "${BACKUP_DIR}:/backup" \
    alpine tar -czf "/backup/$2" -C /data .
}

# O dump precisa do container do banco de pé; falhar aqui é melhor que gerar arquivo vazio.
docker compose exec -T db pg_isready -U postgres -d "$DB_NAME" > /dev/null

echo "Banco → ${PREFIX}.dump"
docker compose exec -T db pg_dump -U postgres -Fc "$DB_NAME" > "${BACKUP_DIR}/${PREFIX}.dump"

echo "Planilhas importadas → ${PREFIX}_storage.tar.gz"
archive_volume storage "${PREFIX}_storage.tar.gz"

# O H2 do Metabase é um arquivo aberto pelo processo: copiado a quente sairia inconsistente.
# O serviço para pelo tempo do tar e volta mesmo se o comando falhar — mas só volta se estava
# de pé. Deixá-lo parado é decisão de segurança (ele nunca passou pelo setup inicial, e quem
# alcança a porta 3001 conclui o setup); um backup noturno não pode desfazê-la.
echo "Metabase → ${PREFIX}_metabase.tar.gz"
if docker compose ps --status running --services | grep -qx metabase; then
  docker compose stop metabase > /dev/null
  trap 'docker compose start metabase > /dev/null' EXIT
  archive_volume metabase_data "${PREFIX}_metabase.tar.gz"
  docker compose start metabase > /dev/null
  trap - EXIT
else
  archive_volume metabase_data "${PREFIX}_metabase.tar.gz"
fi

# Rotação por idade: o disco é o mesmo do banco, então guardar demais não protege nada.
find "$BACKUP_DIR" -maxdepth 1 -name 'fiserv_*' -type f -mtime "+${BACKUP_KEEP_DAYS}" -delete

echo "Pronto em ${BACKUP_DIR} (retenção: ${BACKUP_KEEP_DAYS} dias)"
ls -lh "${BACKUP_DIR}/${PREFIX}"* | awk '{ print "  " $9 " (" $5 ")" }'
