#!/bin/bash
# Atualiza o portal no berry: é a cadeia de deploy depois do merge na main, num comando
# (`ssh berry ~/repos/franchise-intelligence/bin/deploy`).
#
# O backup vem antes do build de propósito: a migração corre no db:prepare do entrypoint
# quando o web sobe, e o dump é o que permite voltar. Não há rollback automático — as
# imagens anteriores ficam em `docker image ls`, e voltar é `git checkout <sha>` seguido
# de `docker compose up -d --build web worker`.
set -euo pipefail

cd "$(dirname "$0")/.."

git pull --ff-only
bin/db-backup
docker compose up -d --build web worker
docker compose ps

# Duas checagens, porque nenhuma sozinha prova que a produção está no ar.
#
# Não use fiserv.bin aqui: desde 22/09/2026 esse nome é a homologação, no Mac. Um deploy
# verificado por ele passa verde com a produção quebrada — ou até com o berry fora do ar,
# desde que o Mac esteja ligado. Foi o que aconteceu no primeiro deploy depois da virada.
docker compose exec -T web curl -fsS -o /dev/null -w "app (dentro do container) → %{http_code}\n" \
  http://localhost:3000/up

# E a ponta pública: sem sessão o Access responde 302, e isso só acontece se o túnel estiver
# entregando ao edge. 200 aqui seria mau sinal — significaria o portal sem porteiro.
codigo="$(curl -s -o /dev/null -w "%{http_code}" --max-time 20 https://manager.melopay.com.br/)"
echo "manager.melopay.com.br → ${codigo}"
case "$codigo" in
  302) ;;
  200) echo "ALERTA: respondeu 200 sem login — a política do Access não está ativa." >&2; exit 1 ;;
  *)   echo "ALERTA: esperado 302 (login do Access); confira o túnel." >&2; exit 1 ;;
esac
